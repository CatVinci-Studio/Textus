{
  "name": "textus",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dev:playground": "vite --config vite.playground.config.ts",
    "build:playground": "tsc && vite build --config vite.playground.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:roundtrip": "node scripts/roundtrip-corpus/run.mjs",
    "test:e2e": "playwright test --ignore-snapshots",
    "test:visual": "playwright test",
    "bench:large-doc": "playwright test -c playwright.perf.config.ts large-doc.perf.ts",
    "bench:plugins": "playwright test -c playwright.perf.config.ts plugins.perf.ts",
    "setup:e2e": "playwright install chromium",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check && node scripts/check-readmes.mjs && node scripts/check-code-shape.mjs && node scripts/check-cycles.mjs && knip --no-progress && node scripts/check-versions.mjs && node scripts/check-nsis-template.mjs && node scripts/updater-manifest.mjs check",
    "check:quick": "node scripts/check-quick.mjs",
    "check:native": "node scripts/check-native.mjs",
    "check:all": "node scripts/check-all.mjs",
    "screenshots:readme": "playwright test -c playwright.shots.config.ts --project=readme",
    "screenshots:website": "playwright test -c playwright.shots.config.ts --project=website",
    "screenshots:plugins": "playwright test -c playwright.shots.config.ts --project=plugins",
    "screenshots:review": "playwright test -c playwright.shots.config.ts --project=review",
    "bench:motion": "playwright test -c playwright.bench.config.ts",
    "sync-models": "node scripts/sync-models.mjs",
    "bindings": "node scripts/write-bindings.mjs"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.3",
    "@milkdown/react": "^7.22.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "marked": "^16.4.2",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-markdown": "^2.2.0",
    "mermaid": "^11.17.2",
    "micromark-util-chunked": "^2.0.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-resolve-all": "^2.0.1",
    "pele": "^1.9.0",
    "prosemirror-highlight": "^0.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "refractor": "^5.0.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0",
    "tiny-pinyin": "1.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gemoji": "8.1.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "jszip": "3.10.2",
    "knip": "^5.88.1",
    "micromark-util-types": "^2.0.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "katex": "$katex"
  }
}
