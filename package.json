{
  "name": "textus",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dev:playground": "vite --config vite.playground.config.ts",
    "build:playground": "tsc && vite build --config vite.playground.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --ignore-snapshots",
    "test:visual": "playwright test",
    "setup:e2e": "playwright install chromium",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check && node scripts/check-readmes.mjs && node scripts/check-versions.mjs && node scripts/updater-manifest.mjs check",
    "check:native": "node scripts/check-native.mjs",
    "check:all": "node scripts/check-all.mjs",
    "screenshots:readme": "playwright test -c playwright.shots.config.ts --project=readme",
    "screenshots:website": "playwright test -c playwright.shots.config.ts --project=website",
    "screenshots:review": "playwright test -c playwright.shots.config.ts --project=review",
    "sync-models": "node scripts/sync-models.mjs"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.3",
    "@milkdown/react": "^7.22.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.11",
    "katex": "^0.17.0",
    "marked": "^16.4.2",
    "mdast-util-to-markdown": "^2.1.2",
    "mermaid": "^11.16.0",
    "micromark-util-chunked": "^2.0.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-resolve-all": "^2.0.1",
    "prosemirror-highlight": "^0.15.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "refractor": "^5.0.0",
    "remark-cjk-friendly": "^2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark-util-types": "^2.0.2",
    "prettier": "^3.9.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
