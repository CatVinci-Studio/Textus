  .milkdown th > :first-child {\n    margin-top: 0;\n  }\n\n  .milkdown blockquote > :last-child,\n  .milkdown li > :last-child,\n  .milkdown td > :last-child,\n  .milkdown th > :last-child,\n  /* The column-resize handle (milkdown-theme.css) is a widget appended to\n     the hovered cell, which would otherwise make the paragraph before it\n     no longer the last child - its margin came back and the whole row\n     grew while the border was hovered. */\n  .milkdown td > :has(+ .column-resize-handle:last-child),\n  .milkdown th > :has(+ .column-resize-handle:last-child) {\n    margin-bottom: 0;\n  }\n\n  .milkdown h1 {\n    font-size: 1.9em;\n  }\n\n  .milkdown h2 {\n    font-size: 1.5em;\n  }\n\n  .milkdown h3 {\n    font-size: 1.25em;\n  }\n\n  .milkdown h4 {\n    font-size: 1.1em;\n  }\n\n  /* Never below the text they head: the browser's own 0.83em and 0.67em\n     set h5 and h6 in smaller print than the paragraph under them (#58).\n     The weight tells h5 from body text; h6 is told from h5 by its colour\n     (below). */\n  .milkdown h5,\n  .milkdown h6 {\n    font-size: 1em;\n  }\n\n  .milkdown p {\n    margin: var(--md-gap) 0;\n  }\n\n  .milkdown blockquote {\n    margin: var(--md-gap-box) 0;\n    padding: 0 1em;\n    border-left: 4px solid var(--editor-border);\n  }\n\n  .milkdown a {\n    color: var(--editor-accent);\n    text-decoration: none;\n  }\n\n  .milkdown a:hover {\n    text-decoration: underline;\n  }\n\n  .milkdown hr {\n    margin: calc(var(--md-gap-box) * 1.5) 0;\n    height: 0;\n    border: none;\n    border-top: 1px solid var(--editor-border);\n  }\n\n  /* Footnotes: the reference a small raised number, each definition its\n     number then its text on one line, in the note's smaller size - not\n     the browser's bare <dl>, which puts the number on a line of its own. */\n  .milkdown sup[data-type=\"footnote_reference\"] {\n    font-size: 0.75em;\n    line-height: 0;\n    color: var(--editor-accent);\n  }\n\n  .milkdown dl[data-type=\"footnote_definition\"] {\n    display: flex;\n    gap: 0.6em;\n    margin: 0.35em 0;\n    font-size: 0.9em;\n    color: var(--editor-muted);\n  }\n\n  .milkdown dl[data-type=\"footnote_definition\"] > dt {\n    flex: none;\n    min-width: 1.2em;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .milkdown dl[data-type=\"footnote_definition\"] > dd {\n    flex: 1;\n    min-width: 0;\n    margin: 0;\n  }\n\n  .milkdown dl[data-type=\"footnote_definition\"] > dd > p {\n    margin: 0;\n  }\n\n  .milkdown code {\n    font-family: var(--font-mono);\n    font-variant-ligatures: normal;\n    font-feature-settings:\n      \"liga\" 1,\n      \"calt\" 1;\n    font-size: 0.9em;\n    background: var(--editor-code-bg);\n    padding: 0.1em 0.35em;\n    border-radius: var(--md-radius-sm);\n  }\n\n  .code-block-wrapper {\n    background: var(--editor-code-bg);\n    border: 1px solid var(--editor-border);\n    border-radius: var(--md-radius);\n    margin: var(--md-gap-box) 0;\n  }\n\n  /* Size and line height live on the <pre>, not just its <code>: the\n     pre's own line box (its strut) is what each line is at least as tall\n     as, so leaving it at the prose 1.8 kept code double-spaced whatever\n     the code element said. */\n  .milkdown pre {\n    font-size: 0.9em;\n    line-height: 1.55;\n    padding: 0.75em 1em;\n    margin: 0;\n    overflow-x: auto;\n  }\n\n  .milkdown pre code {\n    font-family: var(--font-mono);\n    font-variant-ligatures: normal;\n    font-feature-settings:\n      \"liga\" 1,\n      \"calt\" 1;\n    font-size: 1em;\n    background: none;\n    padding: 0;\n    white-space: pre-wrap;\n    word-break: break-word;\n    overflow-wrap: anywhere;\n    /* .milkdown code (above) sets font-size: 0.9em for inline code, and\n       without this the block case kept inheriting .milkdown's prose-tuned\n       1.8 - a line box roughly twice the monospace glyphs' height, which\n       the native caret sizes itself to (most visible on an empty line).\n       Inherits the pre's code-editor spacing. */\n    line-height: inherit;\n  }\n\n  /* The vertical rhythm of a list. Every item's content is a paragraph\n     (list_item content is \"paragraph block*\"), so without this rule each\n     row carries .milkdown p's prose margin and a list reads as a stack of\n     separate paragraphs. Rows sit tighter than prose by default;\n     --editor-list-gap is the theme hook (see the textus-theme skill's\n     variable table). Nested ul/ol are included because their UA margin\n     (1em) is what makes the step into a sublist read wide. */\n  .milkdown li > p,\n  .milkdown li > ul,\n  .milkdown li > ol {\n    margin: var(--editor-list-gap, 0.4em) 0;\n  }\n\n  .milkdown table {\n    border-collapse: collapse;\n    width: 100%;\n  }\n\n  /* Cells sit tighter than prose: the 1.8 body line height and roomy\n     padding made even one-line rows tall (#15). */\n  .milkdown th,\n  .milkdown td {\n    padding: 0.35em 0.75em;\n    line-height: 1.6;\n    border: 1px solid var(--editor-border);\n  }\n\n  /* Not `thead th`: Milkdown keeps the header row in <tbody> (see\n     theme/typora-compat.ts). Headers don't wrap, and body cells keep a\n     small floor: with content-sized columns, CJK text - which may break\n     between any two characters - otherwise let the browser squeeze a short\n     column down to one character (\"序/号\"), wrapping every two-character\n     word (#15). */\n  .milkdown th {\n    text-align: left;\n    white-space: nowrap;\n  }\n\n  .milkdown td {\n    min-width: 3.5em;\n  }\n\n  /* Cells in a cell selection (Select Row/Column, dragging across cells).\n     prosemirror-tables hides the native highlight for these and marks them\n     .selectedCell instead; without a rule they looked unselected (#30). */\n  .milkdown td,\n  .milkdown th {\n    position: relative;\n  }\n\n  .milkdown .selectedCell::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: color-mix(in srgb, var(--editor-accent) 18%, transparent);\n    pointer-events: none;\n  }\n\n  /* Textus's own ornaments - see the header comment. Settings > Theme >\n     Export writes each of these out as a #write rule (theme-export.ts), so\n     keep them one selector per rule under this exact prefix. */\n  :root:not([data-user-theme]) .milkdown h2 {\n    padding-bottom: 0.3em;\n    border-bottom: 1px solid var(--editor-border);\n  }\n\n  :root:not([data-user-theme]) .milkdown h3 {\n    padding-left: 0.6em;\n    border-left: 4px solid var(--editor-accent);\n  }\n\n  :root:not([data-user-theme]) .milkdown h4::before {\n    content: \"\";\n    display: inline-block;\n    width: 0.4em;\n    height: 0.4em;\n    margin-right: 0.5em;\n    border-radius: 50%;\n    background: var(--editor-accent);\n    vertical-align: middle;\n  }\n\n  /* Lighter than h5, short of the muted grey a footnote takes. */\n  :root:not([data-user-theme]) .milkdown h6 {\n    color: color-mix(in srgb, var(--editor-text) 55%, var(--editor-muted));\n  }\n\n  :root:not([data-user-theme]) .milkdown blockquote {\n    color: var(--editor-muted);\n    padding: 0.55em 1em;\n    border-left: 3px solid var(--editor-quote-border);\n    border-radius: 0 var(--md-radius) var(--md-radius) 0;\n    background: var(--editor-code-bg);\n  }\n\n  /* A quiet underline, not bold: a bold link read as bold text. */\n  :root:not([data-user-theme]) .milkdown a {\n    text-decoration: underline;\n    text-decoration-thickness: 1px;\n    text-decoration-color: color-mix(\n      in srgb,\n      var(--editor-accent) 45%,\n      transparent\n    );\n    text-underline-offset: 0.2em;\n  }\n\n  :root:not([data-user-theme]) .milkdown a:hover {\n    text-decoration-color: currentColor;\n  }\n\n  /* Rounded like the code block beside it (--md-radius): separate\n     borders, so the outer edge can take the corner - each cell draws only\n     its right and bottom rule, the table the frame. */\n  :root:not([data-user-theme]) .milkdown table {\n    font-size: 0.95em;\n    border-collapse: separate;\n    border-spacing: 0;\n    border: 1px solid var(--editor-border);\n    border-radius: var(--md-radius);\n  }\n\n  :root:not([data-user-theme]) .milkdown :is(th, td) {\n    border-width: 0 1px 1px 0;\n  }\n\n  :root:not([data-user-theme]) .milkdown tr > :is(th, td):last-child {\n    border-right-width: 0;\n  }\n\n  :root:not([data-user-theme]) .milkdown tr:last-child > :is(th, td) {\n    border-bottom-width: 0;\n  }\n\n  :root:not([data-user-theme]) .milkdown tr:first-child > :first-child {\n    border-top-left-radius: calc(var(--md-radius) - 1px);\n  }\n\n  :root:not([data-user-theme]) .milkdown tr:first-child > :last-child {\n    border-top-right-radius: calc(var(--md-radius) - 1px);\n  }\n\n  :root:not([data-user-theme]) .milkdown tr:last-child > :first-child {\n    border-bottom-left-radius: calc(var(--md-radius) - 1px);\n  }\n\n  :root:not([data-user-theme]) .milkdown tr:last-child > :last-child {\n    border-bottom-right-radius: calc(var(--md-radius) - 1px);\n  }\n\n  :root:not([data-user-theme]) .milkdown th {\n    background: var(--editor-code-bg);\n  }\n}\n"
