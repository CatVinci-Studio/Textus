ce-input:focus {\n  outline: none;\n}\n\n.find-replace-count {\n  flex: none;\n  color: var(--editor-muted);\n  font-size: var(--text-xs);\n  white-space: nowrap;\n  /* Counts change in place without their digits shifting. */\n  font-variant-numeric: tabular-nums;\n}\n\n.find-replace-count-error {\n  color: var(--danger);\n}\n\n.find-replace-nav {\n  flex: none;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n/* Prev / next / close hold icons, not glyphs, so their buttons centre the\n   SVG instead of inheriting a text button's baseline padding. */\n.find-replace-nav button {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.find-replace-bar button {\n  border: 1px solid var(--editor-border);\n  border-radius: var(--radius-control);\n  padding: 4px 7px;\n  font-size: var(--text-sm);\n  cursor: pointer;\n  background: transparent;\n  color: var(--editor-text);\n}\n\n.find-replace-bar button:hover:not(:disabled) {\n  background: var(--editor-code-bg);\n}\n\n.find-replace-bar button:disabled {\n  opacity: 0.4;\n  cursor: default;\n}\n\n.find-replace-toggle {\n  flex: none;\n  width: 22px;\n  height: 22px;\n  padding: 0 !important;\n  border: none !important;\n  border-radius: var(--radius-control) !important;\n  font-size: var(--text-xs) !important;\n  line-height: 1;\n  color: var(--editor-muted);\n}\n\n.find-replace-toggle-active {\n  background: var(--chrome-primary) !important;\n  color: #fff !important;\n}\n\n.find-replace-close {\n  border: none !important;\n  line-height: 1;\n  padding: 4px 6px !important;\n  color: var(--editor-muted);\n}\n\n/* Prev/next share one arrow (see ArrowUpIcon); this is the \"next\" half. */\n.find-replace-arrow-down {\n  transform: rotate(180deg);\n}\n\n.find-match {\n  background: rgba(255, 212, 0, 0.4);\n  border-radius: var(--md-radius-sm);\n}\n\n.find-match-active {\n  background: rgba(255, 140, 0, 0.55);\n}\n"
