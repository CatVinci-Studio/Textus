const __vite__css = "/* Built-in content themes - each only overrides the editor-content CSS\n   variables (--editor-*), never the app chrome (--bg, --sidebar-*), so\n   switching themes only reskins the writing area, not the whole app shell.\n   Scoped by `data-content-theme`, set by SettingsContext; combined with the\n   existing `data-theme` (light/dark) attribute the same way milkdown-theme.css\n   already does for syntax-highlight token colors.\n\n   THEME AND APPEARANCE ARE ORTHOGONAL. Settings picks them separately (which\n   theme, and light/dark/system), so every combination has to be defined -\n   there is no \"this theme is a dark theme\". Each one is therefore three\n   blocks, in this order:\n\n     [data-content-theme=\"x\"]                      base: the light form, and\n                                                   anything shared (fonts)\n     @media (prefers-color-scheme: dark)\n       :root:not([data-theme=\"light\"])[…=\"x\"]      dark, for \"follow system\"\n     :root[data-theme=\"dark\"][…=\"x\"]               dark, pinned\n\n   The two dark blocks are identical by construction; the base block is\n   unconditional, so the dark ones only restate what actually CHANGES\n   (colors) and inherit the rest. A theme with a single design still needs\n   all three - give the dark blocks the same values as the base, so that\n   switching appearance leaves it alone instead of half-applying. */\n\n/* Paper - warm, cream, serif-leaning */\n\n[data-content-theme=\"paper\"] {\n  --editor-bg: #faf6ee;\n  --editor-text: #2b2620;\n  --editor-muted: #706758;\n  --editor-border: #e4dcc8;\n  --editor-quote-border: #b5652f;\n  --editor-accent: #9a5628;\n  --editor-code-bg: #f1e9d8;\n  /* The CJK faces follow <html lang> (ui/base.css). */\n  --editor-font:\n    var(--font-cjk-punct-serif), Georgia, var(--font-cjk-serif), serif;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"])[data-content-theme=\"paper\"] {\n    --editor-bg: #1f1b16;\n    --editor-text: #e8ddc9;\n    --editor-muted: #9c8f77;\n    --editor-border: #3a3226;\n    --editor-quote-border: #d98b52;\n    --editor-accent: #d98b52;\n    --editor-code-bg: #2b241c;\n  }\n}\n\n:root[data-theme=\"dark\"][data-content-theme=\"paper\"] {\n  --editor-bg: #1f1b16;\n  --editor-text: #e8ddc9;\n  --editor-muted: #9c8f77;\n  --editor-border: #3a3226;\n  --editor-quote-border: #d98b52;\n  --editor-accent: #d98b52;\n  --editor-code-bg: #2b241c;\n}\n\n/* Slate - cool, minimal, blue accent */\n\n[data-content-theme=\"slate\"] {\n  --editor-bg: #f7f8fa;\n  --editor-text: #1c2128;\n  --editor-muted: #656d77;\n  --editor-border: #d8dee4;\n  --editor-quote-border: #3568d4;\n  --editor-accent: #3467d2;\n  --editor-code-bg: #eef1f5;\n  --editor-font:\n    var(--font-cjk-punct), -apple-system, \"Inter\", var(--font-text-sans),\n    sans-serif;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"])[data-content-theme=\"slate\"] {\n    --editor-bg: #0d1117;\n    --editor-text: #e6edf3;\n    --editor-muted: #8b949e;\n    --editor-border: #30363d;\n    --editor-quote-border: #6ea8fe;\n    --editor-accent: #6ea8fe;\n    --editor-code-bg: #161b22;\n  }\n}\n\n:root[data-theme=\"dark\"][data-content-theme=\"slate\"] {\n  --editor-bg: #0d1117;\n  --editor-text: #e6edf3;\n  --editor-muted: #8b949e;\n  --editor-border: #30363d;\n  --editor-quote-border: #6ea8fe;\n  --editor-accent: #6ea8fe;\n  --editor-code-bg: #161b22;\n}\n\n/* Forest - low-saturation green, easy on the eyes */\n\n[data-content-theme=\"forest\"] {\n  --editor-bg: #f5f7f2;\n  --editor-text: #22301f;\n  --editor-muted: #616d5a;\n  --editor-border: #dbe3d3;\n  --editor-quote-border: #4c7a4c;\n  --editor-accent: #487448;\n  --editor-code-bg: #e9efe3;\n  --editor-font:\n    var(--font-cjk-punct), -apple-system, \"Inter\", var(--font-text-sans),\n    sans-serif;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"])[data-content-theme=\"forest\"] {\n    --editor-bg: #141a12;\n    --editor-text: #dce8d6;\n    --editor-muted: #8ea184;\n    --editor-border: #2a3526;\n    --editor-quote-border: #79b579;\n    --editor-accent: #79b579;\n    --editor-code-bg: #1c2419;\n  }\n}\n\n:root[data-theme=\"dark\"][data-content-theme=\"forest\"] {\n  --editor-bg: #141a12;\n  --editor-text: #dce8d6;\n  --editor-muted: #8ea184;\n  --editor-border: #2a3526;\n  --editor-quote-border: #79b579;\n  --editor-accent: #79b579;\n  --editor-code-bg: #1c2419;\n}\n\n/* Parchment - aged vellum, sepia ink, handwritten feel */\n\n[data-content-theme=\"parchment\"] {\n  --editor-bg: #f1e6c8;\n  --editor-text: #4a3826;\n  --editor-muted: #6d5b45;\n  --editor-border: #c9b587;\n  --editor-quote-border: #a68a55;\n  --editor-accent: #8c3a2b;\n  --editor-code-bg: #e8dab0;\n  --editor-font:\n    \"Bradley Hand\", \"Segoe Script\", \"STKaiti\", \"Kaiti SC\", \"楷体\",\n    \"LXGW WenKai\", \"AR PL UKai CN\", cursive, serif;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"])[data-content-theme=\"parchment\"] {\n    --editor-bg: #241d13;\n    --editor-text: #d8c9a3;\n    --editor-muted: #9e8c6b;\n    --editor-border: #4a3d28;\n    --editor-quote-border: #5c4a30;\n    --editor-accent: #c97a5c;\n    --editor-code-bg: #2e2517;\n  }\n}\n\n:root[data-theme=\"dark\"][data-content-theme=\"parchment\"] {\n  --editor-bg: #241d13;\n  --editor-text: #d8c9a3;\n  --editor-muted: #9e8c6b;\n  --editor-border: #4a3d28;\n  --editor-quote-border: #5c4a30;\n  --editor-accent: #c97a5c;\n  --editor-code-bg: #2e2517;\n}\n"
