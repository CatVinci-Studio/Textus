const __vite__css = "/* Turn hierarchy: the user's own words are the quiet reference point and the\n   agent's reply is the thing being read, so the two are distinguished by\n   weight and alignment rather than by two competing coloured bubbles. A long\n   conversation of uniform tinted blocks is what this replaced. */\n.agent-message {\n  font-size: var(--text-md);\n  line-height: 1.55;\n  padding: 8px 10px;\n  border-radius: var(--radius-surface);\n  max-width: 92%;\n  word-break: break-word;\n}\n\n/* Sent from the trailing edge: the corner nearest the composer it came\n   from stays tight, as a message bubble's does. */\n.agent-message-user {\n  align-self: flex-end;\n  max-width: 86%;\n  padding: 7px 12px;\n  border-bottom-right-radius: var(--radius-small);\n  background: var(--sidebar-active);\n  color: var(--sidebar-active-text);\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n/* Plain text, not rendered markdown - literal newlines should still break\n   lines. Scoped to the prose itself so the context chips above it aren't\n   stretched by the same whitespace rule. */\n.agent-message-body {\n  white-space: pre-wrap;\n}\n\n/* Selection / attachments that rode along with the message. They're context\n   the user chose, so they stay visible - but as compact chips, not as the raw\n   <selected-text>/<attached-file> blocks that used to bury the actual\n   sentence they typed. */\n.agent-message-context {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n}\n\n.agent-context-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: var(--text-xs);\n  line-height: 1.4;\n  padding: 2px 6px;\n  border-radius: var(--radius-pill);\n  border: none;\n  background: color-mix(in srgb, var(--sidebar-active-text) 16%, transparent);\n  color: inherit;\n  opacity: 0.85;\n}\n\nbutton.agent-context-chip {\n  cursor: pointer;\n}\n\nbutton.agent-context-chip:hover {\n  opacity: 1;\n}\n\n.agent-context-chip-caret {\n  /* One chevron, rotated - a separate \"down\" glyph is a second thing to keep\n     in sync, and the rotation animates for free. */\n  flex-shrink: 0;\n  transition: transform var(--dur-fast) var(--ease-standard);\n}\n\n.agent-context-chip-caret-open {\n  transform: rotate(90deg);\n}\n\n/* Tool-call and attachment chips: the icon sits on the text's baseline row\n   rather than being a leading character, so a wrapped name doesn't tuck\n   under it. */\n.agent-tool-icon {\n  flex-shrink: 0;\n}\n\n/* The expanded selection: monospaced and scroll-capped, so checking what was\n   sent never costs more than a few lines of the transcript. */\n.agent-message-selection {\n  margin: 0;\n  font-size: var(--text-xs);\n  line-height: 1.45;\n  white-space: pre-wrap;\n  word-break: break-word;\n  max-height: 160px;\n  overflow-y: auto;\n  padding: 6px 8px;\n  border-radius: var(--radius-block);\n  background: color-mix(in srgb, var(--sidebar-active-text) 12%, transparent);\n}\n\n/* No bubble and no rule: the reply is the main content of the panel, read\n   at the panel's full width like any text. The user's tinted bubble on the\n   other side is what tells the two apart - a second mark (the accent rule\n   it had) only added a stripe down every answer. */\n.agent-message-assistant {\n  align-self: stretch;\n  max-width: 100%;\n  padding: 0 2px;\n  border-radius: 0;\n  color: var(--editor-text);\n  line-height: 1.6;\n}\n\n/* The assistant reply rendered as markdown (see MarkdownText) - block\n   elements already carry their own spacing, so children lose the default\n   paragraph margins that would otherwise stack with the bubble's own\n   padding. */\n.agent-markdown > *:first-child {\n  margin-top: 0;\n}\n\n.agent-markdown > *:last-child {\n  margin-bottom: 0;\n}\n\n.agent-markdown p,\n.agent-markdown ul,\n.agent-markdown ol,\n.agent-markdown blockquote,\n.agent-markdown pre {\n  margin: 0.5em 0;\n}\n\n.agent-markdown ul,\n.agent-markdown ol {\n  padding-left: 1.4em;\n}\n\n.agent-markdown code {\n  background: var(--editor-code-bg);\n  border-radius: var(--radius-small);\n  padding: 1px 4px;\n  font-size: 0.92em;\n}\n\n.agent-markdown pre {\n  background: var(--editor-code-bg);\n  border-radius: var(--radius-block);\n  padding: 6px 8px;\n  overflow-x: auto;\n}\n\n.agent-markdown pre code {\n  background: none;\n  padding: 0;\n}\n\n.agent-markdown blockquote {\n  border-left: 2px solid var(--editor-border);\n  padding-left: 8px;\n  color: var(--editor-muted);\n}\n\n.agent-markdown a {\n  color: var(--editor-accent);\n  text-decoration: none;\n}\n\n.agent-markdown a:hover {\n  text-decoration: underline;\n}\n\n/* Headings stay close to the reply's own size - this is a chat answer,\n   not a document, so they mark sections without shouting. */\n.agent-markdown h1,\n.agent-markdown h2,\n.agent-markdown h3,\n.agent-markdown h4,\n.agent-markdown h5,\n.agent-markdown h6 {\n  margin: 0.9em 0 0.35em;\n  font-weight: 600;\n  line-height: 1.35;\n}\n\n.agent-markdown h1 {\n  font-size: 1.3em;\n}\n\n.agent-markdown h2 {\n  font-size: 1.18em;\n}\n\n.agent-markdown h3 {\n  font-size: 1.08em;\n}\n\n.agent-markdown h4,\n.agent-markdown h5,\n.agent-markdown h6 {\n  font-size: 1em;\n}\n\n.agent-markdown li + li {\n  margin-top: 0.2em;\n}\n\n.agent-markdown li > p {\n  margin: 0;\n}\n\n/* GFM task list items carry their own checkbox. */\n.agent-markdown li:has(> input[type=\"checkbox\"]) {\n  list-style: none;\n  margin-left: -1.2em;\n}\n\n.agent-markdown input[type=\"checkbox\"] {\n  margin: 0 0.4em 0 0;\n  vertical-align: -0.1em;\n}\n\n.agent-markdown hr {\n  margin: 0.8em 0;\n  border: none;\n  border-top: 1px solid var(--editor-border);\n}\n\n.agent-markdown img {\n  max-width: 100%;\n  border-radius: var(--radius-block);\n}\n\n/* Tables scroll sideways inside the reply instead of widening it. */\n.agent-markdown table {\n  display: block;\n  max-width: 100%;\n  overflow-x: auto;\n  margin: 0.5em 0;\n  border-collapse: collapse;\n  font-size: 0.95em;\n}\n\n.agent-markdown th,\n.agent-markdown td {\n  padding: 4px 8px;\n  border: 1px solid var(--editor-border);\n  text-align: left;\n}\n\n.agent-markdown th {\n  background: var(--editor-code-bg);\n  font-weight: 600;\n}\n\n.agent-math {\n  margin: 0.5em 0;\n  overflow-x: auto;\n  overflow-y: hidden;\n}\n\n.agent-markdown .katex {\n  font-size: 1.05em;\n}\n\n.agent-markdown .katex-display {\n  margin: 0;\n}\n\n/* Tool calls are progress notes, not content - readable if looked for,\n   invisible if not. */\n.agent-tool-line {\n  align-self: flex-start;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: var(--text-xs);\n  color: var(--editor-muted);\n  padding: 0 2px;\n}\n\n.agent-tool-line .agent-tool-icon {\n  width: 11px;\n  height: 11px;\n  opacity: 0.8;\n}\n\n.agent-tool-result {\n  align-self: flex-start;\n  font-size: var(--text-xs);\n  color: var(--editor-muted);\n  max-width: 92%;\n  padding: 0 2px;\n}\n\n/* The disclosure is the step's footnote: the app's own small caret rather\n   than the browser's triangle, quiet until hovered. */\n.agent-tool-result > summary {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  list-style: none;\n  cursor: pointer;\n  opacity: 0.8;\n  transition: opacity var(--dur-fast) var(--ease-standard);\n}\n\n.agent-tool-result > summary::-webkit-details-marker {\n  display: none;\n}\n\n.agent-tool-result > summary::before {\n  content: \"\";\n  width: 0;\n  height: 0;\n  margin: 0 2px 0 3px;\n  border-left: 4px solid currentColor;\n  border-top: 3.5px solid transparent;\n  border-bottom: 3.5px solid transparent;\n  transition: transform var(--dur-fast) var(--ease-standard);\n}\n\n.agent-tool-result[open] > summary::before {\n  transform: rotate(90deg);\n}\n\n.agent-tool-result > summary:hover {\n  opacity: 1;\n  color: var(--editor-text);\n}\n\n.agent-tool-result pre {\n  white-space: pre-wrap;\n  word-break: break-word;\n  background: var(--editor-code-bg);\n  border-radius: var(--radius-block);\n  padding: 6px 8px;\n  margin: 4px 0 0;\n}\n\n.agent-thinking {\n  align-self: flex-start;\n  font-size: var(--text-sm);\n  color: var(--editor-muted);\n  font-style: italic;\n  padding: 4px 6px;\n}\n\n/* A failed request: the same card shape as a proposal or a comment, tinted\n   in the danger colour - what went wrong in words, the provider's own\n   message under it, and Retry. */\n.agent-error {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 6px;\n  margin: 6px 0;\n  padding: 8px 10px;\n  border: 1px solid color-mix(in srgb, var(--danger) 30%, transparent);\n  border-radius: var(--radius-surface);\n  background: color-mix(in srgb, var(--danger) 7%, transparent);\n  font-size: var(--text-md);\n  line-height: 1.5;\n  color: var(--editor-text);\n  word-break: break-word;\n}\n"
