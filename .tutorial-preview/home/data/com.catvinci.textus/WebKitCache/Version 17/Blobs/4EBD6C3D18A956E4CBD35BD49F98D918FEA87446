X(14px);\n  }\n}\n\n.review-note-by {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin-bottom: 2px;\n  font-size: var(--text-xs);\n  color: var(--editor-muted);\n}\n\n.review-note-mark {\n  display: inline-grid;\n  place-items: center;\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: color-mix(in srgb, var(--editor-accent) 14%, transparent);\n  color: var(--editor-accent);\n  font-size: 8.5px;\n  font-weight: 700;\n}\n\n.review-note-text {\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n/* The actions open under the note on hover (always, by touch or focus). */\n.review-note-actions {\n  display: flex;\n  gap: 6px;\n  max-height: 0;\n  margin-top: 0;\n  overflow: hidden;\n  opacity: 0;\n  transition:\n    max-height var(--dur-medium) var(--ease-out),\n    margin var(--dur-medium) var(--ease-out),\n    opacity var(--dur-fast) var(--ease-out);\n}\n\n.review-note:is(:hover, :focus-within, .review-note-hot, .review-note-popover)\n  .review-note-actions {\n  max-height: 32px;\n  margin-top: 7px;\n  opacity: 1;\n}\n\n.review-note-actions button {\n  padding: 2px 10px;\n  border-radius: var(--radius-pill);\n  border: 1px solid var(--review-note-border);\n  background: var(--editor-bg, var(--bg));\n  color: var(--editor-text);\n  font: inherit;\n  font-size: var(--text-xs);\n  cursor: pointer;\n}\n\n.review-note-actions button:hover {\n  border-color: var(--review-note-line);\n}\n\n.review-note-popover {\n  position: fixed;\n  z-index: 400;\n  width: 260px;\n  animation: motion-pop-in var(--dur-fast) var(--ease-out);\n}\n\n/* The passage a note is about, and its badge when there's no margin. */\n.review-anchor {\n  background: var(--review-anchor-bg);\n  box-shadow: inset 0 -1.5px 0 var(--review-note-line);\n  border-radius: 2px;\n  transition: background var(--dur-fast) var(--ease-standard);\n}\n\n.review-anchor-hot {\n  background: var(--review-anchor-hot-bg);\n}\n\n.review-badge {\n  display: inline-grid;\n  place-items: 