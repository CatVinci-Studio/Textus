he right, the replacement below. Same card as\n   a note, in the editor's own surface tone - a note is the reviewer's\n   paper, a revision is a draft of the text itself. */\n.revision-note {\n  background: color-mix(\n    in srgb,\n    var(--editor-text) 3%,\n    var(--editor-bg, var(--bg))\n  );\n  border-color: color-mix(\n    in srgb,\n    var(--editor-border, var(--border-color)) 80%,\n    transparent\n  );\n}\n\n.revision-note .review-note-by {\n  margin-bottom: 4px;\n}\n\n.revision-note-num {\n  display: inline-grid;\n  place-items: center;\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: var(--success-color);\n  color: #fff;\n  font-size: 9.5px;\n  font-weight: 700;\n  font-variant-numeric: tabular-nums;\n}\n\n.revision-note-pick {\n  margin-left: auto;\n}\n\n.revision-note-text {\n  padding: 1px 4px;\n  margin: 0 -4px;\n  border-radius: var(--radius-small);\n  background: var(--diff-insert-bg);\n  overflow-wrap: anywhere;\n  -webkit-box-decoration-break: clone;\n  box-decoration-break: clone;\n  transition:\n    background var(--dur-fast) var(--ease-standard),\n    opacity var(--dur-fast) var(--ease-standard);\n}\n\n.revision-note-delete {\n  font-style: italic;\n  color: var(--editor-muted);\n}\n\n.revision-note-kept .revision-note-num {\n  background: color-mix(in srgb, var(--editor-muted) 70%, transparent);\n}\n\n.revision-note-kept .revision-note-text {\n  background: none;\n  opacity: 0.5;\n  text-decoration: line-through;\n}\n\n.review-links path.revision {\n  stroke: color-mix(in srgb, var(--success-color) 70%, transparent);\n}\n\n/* A pending sentence under the pointer, or its card under it. */\n.pending-sentence-hot {\n  box-shadow: 0 0 0 2px\n    color-mix(in srgb, var(--editor-accent) 35%, transparent);\n  border-radius: var(--radius-small);\n}\n\n/* \"Changes in the text\": the card holds the original, struck. */\n.revision-note-original {\n  background: var(--diff-delete-bg);\n  color: var(--editor-muted);\n}\n\n.revision-note-original s {\n  text-decoration-color: var(--diff-delete-line);\n}\n\n.revision-note-was {\n  display: block;\n  margin-bottom: 1px;\n  font-size: var(--text-xs);\n  color: var(--editor-muted);\n}\n\n/* Kept: the original is the text again. */\n.revision-note-kept .revision-note-original {\n  background: none;\n  text-decoration: none;\n  color: var(--editor-text);\n  opacity: 1;\n}\n\n.revision-note-kept .revision-note-original s {\n  text-decoration: none;\n}\n\n/* Where a pure insertion would go, with its card in the margin. */\n.pending-insert-mark {\n  display: inline-block;\n  width: 2px;\n  height: 1.1em;\n  margin: 0 1px;\n  vertical-align: -0.15em;\n  border-radius: 1px;\n  background: var(--success-color);\n}\n"
