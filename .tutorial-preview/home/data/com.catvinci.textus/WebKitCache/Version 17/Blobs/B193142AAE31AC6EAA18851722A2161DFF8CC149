adding: 0 10px;\n  border: none;\n  background: none;\n  color: var(--chrome-accent);\n  font: inherit;\n  /* A navigation bar button, as Settings' Done. */\n  font-size: var(--ios-body);\n}\n\n.document-list-body {\n  /* The offset parent a deleted document's last look is left in. */\n  position: relative;\n  flex: 1;\n  overflow-y: auto;\n  -webkit-overflow-scrolling: touch;\n  padding: 6px 0 24px;\n}\n\n.document-list-empty {\n  margin: 48px 24px;\n  text-align: center;\n  color: var(--chrome-muted, var(--editor-muted));\n  font-size: var(--text-md);\n}\n\n.document-list-toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 8px 16px 4px;\n}\n\n.document-list-count {\n  font-size: var(--text-sm);\n  color: var(--chrome-muted, var(--editor-muted));\n}\n\n/* A small segmented control, as in Files' view switcher. The raised\n   segment is one thumb under both buttons that slides to the chosen one. */\n.document-list-views {\n  position: relative;\n  display: flex;\n  padding: 2px;\n  border-radius: var(--radius-control);\n  background: color-mix(\n    in srgb,\n    var(--chrome-text, currentColor) 8%,\n    transparent\n  );\n}\n\n.document-list-views::before {\n  content: \"\";\n  position: absolute;\n  top: 2px;\n  bottom: 2px;\n  left: 2px;\n  width: calc(50% - 2px);\n  /* Concentric with the track: its radius less the 2px inset. */\n  border-radius: calc(var(--radius-control) - 2px);\n  background: var(--page-bg, var(--bg));\n  box-shadow: var(--shadow-raised);\n  transition: transform var(--dur-medium) var(--ease-spring);\n}\n\n.document-list-views[data-view=\"grid\"]::before {\n  transform: translateX(100%);\n}\n\n.document-list-view-button {\n  position: relative;\n  display: grid;\n  place-items: center;\n  width: 44px;\n  height: 30px;\n  padding: 0;\n  border: none;\n  background: none;\n  color: var(--chrome-muted, var(--editor-muted));\n  transition: color var(--dur-fast) var(--ease-standard);\n}\n\n.document-list-view-button[aria-checked=\"true\"] {\n  color: var(--chrome-text, var(--editor-text));\n}\n\n/* A page thumbnail: the document's opening lines, tiny, on a sheet. */\n.document-page {\n  position: relative;\n  display: block;\n  flex: none;\n  overflow: hidden;\n  aspect-ratio: 3 / 4;\n  border-radius: var(--radius-small);\n  /* The page's colour where the list's own surface doesn't name one: a\n     white fallback put near-white dark-mode text on white sheets. */\n  background: var(--editor-bg, var(--bg));\n  box-shadow:\n    0 0 0 0.5px color-mix(in srgb, var(--chrome-text, #000) 18%, transparent),\n    0 1px 4px rgb(0 0 0 / 0.08);\n}\n\n.document-page-text {\n  position: absolute;\n  inset: 0;\n  padding: 9% 10%;\n  overflow: hidden;\n  white-space: pre-wrap;\n  text-align: left;\n  overflow-wrap: anywhere;\n  font-family: var(--font-sans);\n  color: var(--editor-text, currentColor);\n  opacity: 0.75;\n}\n\n.document-item {\n  position: relative;\n  border-radius: var(--radius-surface);\n}\n\n/* A document that turns up in an open list; one that goes fades where it\n   was (DocumentList.tsx's ListMotion). */\n.document-item-new {\n  animation: motion-pop-in var(--dur-base) var(--ease-out);\n}\n\n.document-item-ghost {\n  animation: motion-fade-out var(--dur-fast) var(--ease-in) forwards;\n}\n\n.document-item-main {\n  display: flex;\n  min-width: 0;\n  padding: 0;\n  border: none;\n  background: none;\n  color: inherit;\n  font: inherit;\n  -webkit-touch-callout: none;\n  -webkit-user-select: none;\n  user-select: none;\n}\n\n.document-item-text {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  gap: 2px;\n}\n\n.document-item-name {\n  overflow: hidden;\n  font-size: var(--text-md);\n}\n\n.document-item-detail {\n  font-size: var(--text-sm);\n  color: var(--chrome-muted, var(--editor-muted));\n}\n\n/* Rows: small thumbnail, name and detail, \"...\", hairline between rows\n   inset to the text as in iOS lists. */\n.document-list-list .document-item {\n  display: flex;\n  align-items: center;\n  margin: 0 8px;\n}\n\n.document-list-list .document-item-main {\n  flex: 1;\n  align-items: center;\n  gap: 12px;\n  min-height: 64px;\n  padding: 8px 8px 8px 10px;\n  text-align: left;\n}\n\n.document-list-list .document-page {\n  width: 36px;\n}\n\n.document-list-list .document-page-text {\n  font-size: 3px;\n  line-height: 1.35;\n}\n\n.document-list-list .document-item-name {\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.document-list-list .document-item + .document-item::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 58px;\n  right: 0;\n  border-top: 0.5px solid var(--border-color);\n}\n\n.document-list-list .document-item-active {\n  background: color-mix(in srgb, var(--chrome-accent) 10%, transparent);\n}\n\n/* Icons: three across on a phone, more on wider screens; name (two lines,\n   centred) and date under each page. */\n.document-list-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));\n  align-content: start;\n  gap: 20px 14px;\n  padding: 12px 18px 32px;\n}\n\n.document-list-grid .document-item-main {\n  width: 100%;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  text-align: center;\n}\n\n.document-list-grid .document-page {\n  width: 78%;\n}\n\n.document-list-grid .document-page-text {\n  font-size: 5px;\n  line-height: 1.35;\n}\n\n.document-list-grid .document-item-text {\n  align-items: center;\n  max-width: 100%;\n}\n\n.document-list-grid .document-item-name {\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n  font-size: var(--text-sm);\n  line-height: 1.3;\n  overflow-wrap: anywhere;\n}\n\n.document-list-grid .document-item-detail {\n  font-size: var(--text-xs, 11px);\n}\n\n.document-list-grid .document-item-active .document-page {\n  box-shadow:\n    0 0 0 2px var(--chrome-accent),\n    0 1px 4px rgb(0 0 0 / 0.08);\n}\n"
