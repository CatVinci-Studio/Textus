const __vite__css = ".settings-backdrop {\n  position: fixed;\n  inset: 0;\n  background: var(--overlay-bg);\n  /* Modal tier: above the find bar, popovers and toasts (200-300), which\n     otherwise drew over the dimmed backdrop and still took clicks. */\n  z-index: 400;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.settings-panel {\n  /* Settings belong to app chrome, independently of document themes. */\n  --editor-text: var(--chrome-text);\n  --editor-muted: var(--chrome-muted);\n  --editor-accent: var(--chrome-accent);\n  color: var(--editor-text);\n  width: calc(100% - 32px);\n  max-width: 840px;\n  height: min(82dvh, 720px);\n  max-height: calc(100dvh - 32px);\n  display: flex;\n  flex-direction: column;\n  background: var(--bg);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-dialog);\n  box-shadow: var(--shadow-dialog);\n  overflow: hidden;\n}\n\n.settings-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--space-3) var(--space-5);\n  border-bottom: 1px solid var(--border-color);\n  font-size: var(--text-xl);\n  font-weight: 600;\n  flex-shrink: 0;\n}\n\n.settings-close-button {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  line-height: 1;\n  padding: 6px;\n}\n\n.settings-layout {\n  display: flex;\n  flex: 1;\n  min-height: 0;\n}\n\n/* As wide as the longest category name needs, within bounds: a German or\n   Russian \"Editor & Appearance\" gets room for one line, and a name longer\n   still wraps (hyphenated where the language allows) inside the cap. */\n.settings-nav {\n  min-width: 176px;\n  max-width: 232px;\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  padding: 14px 10px;\n  background: var(--sidebar-bg);\n  overflow-y: auto;\n}\n\n.settings-nav-item {\n  display: block;\n  width: 100%;\n  text-align: left;\n  padding: 9px 12px;\n  font-size: var(--text-md);\n  border: none;\n  border-radius: var(--radius-control);\n  background: transparent;\n  color: var(--sidebar-text, var(--editor-muted));\n  cursor: pointer;\n  overflow-wrap: anywhere;\n  hyphens: auto;\n}\n\n.settings-nav-item:hover {\n  background: var(--sidebar-hover);\n}\n\n.settings-nav-item-active {\n  background: var(--sidebar-active);\n  color: var(--sidebar-active-text);\n  font-weight: 500;\n}\n\n/* A new page fades in where the last one was; the nav's highlight moves\n   at once. */\n.settings-content {\n  animation: motion-settle-in var(--dur-fast) var(--ease-out);\n  scrollbar-gutter: stable;\n  overscroll-behavior: contain;\n  flex: 1;\n  min-width: 0;\n  overflow-y: auto;\n  padding: 24px 28px 32px;\n}\n\n/* Information architecture: each group is a quiet inset card - the title\n   floats above it, rows live inside it, and the ONLY rules anywhere are the\n   faint hairlines between adjacent rows of the same card. No group-to-group\n   separators, no full-width rules in open space, no double borders. */\n.settings-group + .settings-group {\n  margin-top: 24px;\n}\n\n.settings-advanced {\n  margin-top: 24px;\n  border: 1px solid color-mix(in srgb, var(--border-color) 75%, transparent);\n  border-radius: var(--radius-surface);\n  background: var(--chrome-subtle);\n  overflow: hidden;\n}\n\n/* The triangle is drawn, as for Custom CSS below: the native marker is a\n   glyph that iOS's font stack lacks, which showed as a missing-character\n   box. */\n.settings-advanced > summary {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 12px 16px;\n  color: var(--editor-muted);\n  font-size: var(--text-md);\n  font-weight: 600;\n  cursor: pointer;\n  list-style: none;\n}\n\n.settings-advanced > summary::-webkit-details-marker {\n  display: none;\n}\n\n.settings-advanced > summary::before {\n  content: \"\";\n  width: 0;\n  height: 0;\n  border-left: 4px solid currentColor;\n  border-top: 3.5px solid transparent;\n  border-bottom: 3.5px solid transparent;\n  transition: transform var(--dur-fast) var(--ease-standard);\n}\n\n.settings-advanced[open] > summary::before {\n  transform: rotate(90deg);\n}\n\n.settings-advanced[open] > summary {\n  border-bottom: 1px solid var(--border-color);\n}\n\n.settings-advanced-body {\n  padding: 0 16px;\n}\n\n.settings-advanced-body > * + * {\n  border-top: 1px solid color-mix(in srgb, var(--border-color) 60%, transparent);\n}\n\n.settings-group-title {\n  margin: 0 0 8px;\n  padding-left: 4px;\n  color: var(--editor-muted);\n  font-size: var(--text-sm);\n  font-weight: 600;\n  line-height: 1.4;\n}\n\n.settings-group-body {\n  padding: 2px 16px;\n  background: var(--chrome-subtle);\n  border: 1px solid color-mix(in srgb, var(--border-color) 75%, transparent);\n  border-radius: var(--radius-surface);\n}\n\n/* The one divider in the design: an inset hairline between adjacent rows of\n   a card (fragments flatten sections into direct children, so this covers\n   every settings.* row and section root alike). */\n.settings-group-body > * + *,\n.provider-picker > * + * {\n  border-top: 1px solid color-mix(in srgb, var(--border-color) 60%, transparent);\n}\n\n/* Every row: the setting's name on the left, its control on the right\n   (sections/controls.tsx's SettingRow), one height throughout. */\n.settings-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  min-height: 48px;\n  padding: 8px 0;\n  box-sizing: border-box;\n  font-size: var(--text-lg);\n}\n\n.settings-row > *:first-child {\n  flex: 1;\n  min-width: 0;\n}\n\n.settings-row-control {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  flex-wrap: wrap;\n  gap: 8px;\n  flex: 0 1 auto;\n  min-width: 0;\n  max-width: 62%;\n}\n\n/* A read-out beside a control (installed / not installed). */\n.settings-row-value {\n  color: var(--editor-muted);\n  font-size: var(--text-md);\n}\n\n/* A row that is itself the button (Help's guides). */\nbutton.settings-link-row {\n  width: 100%;\n  margin: 0;\n  border: none;\n  border-radius: 0;\n  background: none;\n  color: inherit;\n  font: inherit;\n  font-size: var(--text-lg);\n  text-align: left;\n  cursor: pointer;\n}\n\n.settings-link-chevron {\n  flex: none;\n  color: var(--editor-muted);\n}\n\nbutton.settings-danger-button {\n  color: var(--danger);\n}\n\n/* Model ids carry their capabilities (\"· vision · tools · 400K\"), so the\n   picker may be wide - but not wider than the row can give it. */\n.settings-model-select {\n  max-width: 100%;\n}\n\n.settings-toggle-row {\n  cursor: pointer;\n}\n\n.settings-row-label {\n  color: var(--editor-text);\n  font-size: var(--text-lg);\n}\n\n/* Only the few rows that need one have a hint - a value (the folder in\n   use, a fetched-on date) or a line that prevents a mistake. */\n.settings-row-hint {\n  color: var(--editor-muted);\n  font-size: var(--text-md);\n  line-height: 1.45;\n  margin-top: 2px;\n  max-width: 420px;\n  overflow-wrap: anywhere;\n}\n\n/* The sign-in page's address, for when no browser opened: selectable in\n   full (the rest of Settings is not), wrapping anywhere - it is one long\n   word. */\n.settings-login-url {\n  display: block;\n  margin-top: 6px;\n  max-width: 420px;\n  max-height: 4.5em;\n  overflow: auto;\n  font-family: var(--font-mono);\n  font-size: var(--text-sm);\n  color: var(--editor-text);\n  word-break: break-all;\n  user-select: text;\n  -webkit-user-select: text;\n}\n\n/* Toggles render as switches, not native checkboxes - the single clearest\n   \"this is a settings panel\" affordance, and it reads at a glance. */\n.settings-row input[type=\"checkbox\"] {\n  /* The thumb, and how far it travels (the phone's are UIKit's sizes). */\n  --switch-thumb: 17px;\n  --switch-travel: 15px;\n  appearance: none;\n  -webkit-appearance: none;\n  flex-shrink: 0;\n  width: 36px;\n  height: 21px;\n  margin: 0;\n  position: relative;\n  border: none;\n  border-radius: var(--radius-pill);\n  background: color-mix(in srgb, var(--editor-muted) 38%, var(--bg));\n  cursor: pointer;\n  transition: background-color var(--dur-base) var(--ease-standard);\n}\n\n/* The thumb lands with UISwitch's slight overshoot. Reduced motion: it\n   jumps (a travel of 0), and only the track's colour fades. */\n.settings-row input[type=\"checkbox\"]::after {\n  content: \"\";\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: var(--switch-thumb);\n  height: var(--switch-thumb);\n  border-radius: 50%;\n  background: #fff;\n  box-shadow: var(--shadow-thumb);\n  transform-origin: left center;\n  transition: transform calc(var(--dur-medium) * var(--motion-travel))\n    var(--ease-spring-bouncy);\n}\n\n/* On: the theme's ink, like a primary button - its thumb in the page's\n   colour, so a dark theme's light track still shows it. */\n.settings-row input[type=\"checkbox\"]:checked {\n  background: var(--ui-primary);\n}\n\n.settings-row input[type=\"checkbox\"]:checked::after {\n  background: var(--ui-on-primary);\n}\n\n.settings-row input[type=\"checkbox\"]:checked::after {\n  transform: translateX(var(--switch-travel));\n}\n\n/* Held down, the thumb stretches toward the side it would go to, as\n   UISwitch's does, and springs back when let go. */\n.settings-row input[type=\"checkbox\"]:active::after {\n  transform: scaleX(1.2);\n  transition-duration: calc(var(--dur-fast) * var(--motion-travel));\n}\n\n.settings-row input[type=\"checkbox\"]:checked:active::after {\n  transform: translateX(calc(var(--switch-travel) - var(--switch-thumb) * 0.2))\n    scaleX(1.2);\n}\n\n.settings-row input[type=\"checkbox\"]:focus-visible {\n  outline: 2px solid var(--editor-accent);\n  outline-offset: 2px;\n}\n\nbutton.settings-inline-button {\n  width: auto;\n  margin-bottom: 0;\n  flex-shrink: 0;\n  white-space: nowrap;\n  background: var(--bg);\n}\n\n/* A row with two actions (switch / reset), stacked so a long folder path\n   next to them still has room to breathe. */\n.settings-inline-buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  flex-shrink: 0;\n}\n\n/* The resolved project folder. A path is long and matters exactly, so it\n   gets its own line in a mono face rather than being squeezed into the hint. */\n.shortcut-row-controls {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-shrink: 1;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  min-width: 0;\n  max-width: 100%;\n}\n\n.shortcut-capture-button {\n  min-width: 120px;\n  text-align: center;\n  font-family: var(--font-mono);\n  font-size: var(--text-sm);\n}\n\n.shortcut-capture-active {\n  border-color: var(--editor-accent);\n  color: var(--editor-accent);\n}\n\n.api-key-input-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  flex: 1;\n  justify-content: flex-end;\n}\n\n.api-key-input {\n  flex: 1;\n  min-width: 0;\n  max-width: 220px;\n}\n\n.api-key-configured {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-shrink: 0;\n}\n\n.settings-error {\n  padding: 8px 10px;\n  margin: 8px 0;\n  border-left: 2px solid var(--danger);\n  border-radius: 0 var(--radius-control) var(--radius-control) 0;\n  background: color-mix(in srgb, var(--danger) 10%, transparent);\n  color: var(--danger);\n  font-size: var(--text-md);\n  word-break: break-word;\n}\n\n.settings-success {\n  padding: 8px 10px;\n  margin: 8px 0;\n  border-left: 2px solid var(--success-color);\n  border-radius: 0 var(--radius-control) var(--radius-control) 0;\n  background: color-mix(in srgb, var(--success-color) 10%, transparent);\n  color: var(--success-color);\n  font-size: var(--text-md);\n}\n\n/* Inline error/success banners sit between card rows; they carry their own\n   left accent, so suppress the row hairline directly above them. */\n.settings-group-body > .settings-error,\n.settings-group-body > .settings-success {\n  border-top: none;\n}\n\n/* Every <select> in Settings uses this class - a native select otherwise\n   renders with no border/background at all outside `.settings-row`. The\n   native dropdown arrow is replaced (appearance:none) with a drawn chevron\n   matching the app's iconography. */\n.settings-select {\n  min-width: 0;\n  max-width: 100%;\n}\n\n.settings-text-input {\n  flex: 1;\n  min-width: 0;\n  padding: 5px 10px;\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-control);\n  background: var(--bg);\n  color: var(--editor-text);\n  font-size: var(--text-md);\n}\n\n.settings-text-input:focus {\n  outline: none;\n  border-color: var(--editor-accent);\n}\n\n.image-settings-row {\n  align-items: flex-start;\n}\n\n.image-settings-input {\n  width: min(270px, 48%);\n  flex: 0 1 270px;\n}\n\n/* ---- General > AI account: two disclosure rows + expanding panels ---- */\n\n.provider-picker {\n  margin: 0;\n}\n\n.combobox {\n  position: relative;\n}\n\n.combobox-trigger,\n.provider-auth-trigger {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  width: 100%;\n  min-height: 48px;\n  padding: 8px 0;\n  border: none;\n  border-radius: 0;\n  background: none;\n  color: inherit;\n  font: inherit;\n  font-size: var(--text-lg);\n  cursor: pointer;\n  text-align: left;\n}\n\n.combobox-trigger:hover,\n.provider-auth-trigger:hover {\n  background: var(--sidebar-hover);\n}\n\n/* Read like any other row: the name in the text colour, the current value\n   (provider, sign-in state) quieter at the right. */\n.combobox-trigger-label {\n  color: var(--editor-muted);\n}\n\n.provider-disclosure-label {\n  flex: 1;\n  min-width: 0;\n  color: var(--editor-text);\n  font-size: var(--text-lg);\n}\n\n.combobox-caret {\n  flex-shrink: 0;\n  color: var(--editor-muted);\n  transform: rotate(90deg);\n  transition: transform var(--dur-fast) var(--ease-standard);\n}\n\n.combobox-caret-open {\n  transform: rotate(-90deg);\n}\n\n.combobox-popover {\n  position: absolute;\n  top: calc(100% + 6px);\n  left: 0;\n  right: 0;\n  z-index: 10;\n  display: flex;\n  flex-direction: column;\n  background: var(--bg);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-surface);\n  box-shadow: var(--shadow-popover);\n  overflow: hidden;\n}\n\n.combobox-search {\n  border: none;\n  border-bottom: 1px solid var(--border-color);\n  padding: 10px 12px;\n  font-size: var(--text-md);\n  background: transparent;\n  color: var(--editor-text);\n}\n\n.combobox-search:focus {\n  outline: none;\n}\n\n.combobox-list {\n  max-height: 260px;\n  overflow-y: auto;\n  padding: 4px;\n}\n\n.combobox-option {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 8px 10px;\n  border: none;\n  border-radius: var(--radius-control);\n  background: none;\n  color: inherit;\n  font: inherit;\n  font-size: var(--text-md);\n  text-align: left;\n  cursor: pointer;\n}\n\n.combobox-option:hover {\n  background: var(--sidebar-hover);\n}\n\n.combobox-option-active {\n  background: var(--sidebar-active);\n  color: var(--sidebar-active-text);\n}\n\n.combobox-option-label {\n  flex: 1;\n  min-width: 0;\n}\n\n.combobox-empty {\n  padding: 10px 12px;\n  font-size: var(--text-md);\n  color: var(--editor-muted);\n}\n\n.status-pill {\n  margin-left: auto;\n  font-size: var(--text-sm);\n  color: var(--editor-muted);\n  white-space: nowrap;\n}\n\n.status-pill-connected {\n  color: var(--success-color);\n}\n\n.status-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--success-color);\n  flex-shrink: 0;\n}\n\n/* Expanded credentials: indented behind an accent-tinted rail, the same\n   \"dependent detail\" language the AI tab's sub-options use. */\n.provider-picker > .provider-panel {\n  border-top: none;\n}\n\n.provider-panel {\n  margin: 2px 0 12px 8px;\n  padding: 0 0 0 14px;\n  border-left: 2px solid\n    color-mix(in srgb, var(--editor-accent) 35%, var(--border-color));\n}\n\n.provider-panel .settings-row,\n.provider-panel .settings-field {\n  padding: 9px 0;\n}\n\n/* Account vs API key: a segmented control instead of underline tabs - one\n   fewer horizontal rule, and the choice reads as the mode switch it is. */\n.auth-tabs {\n  display: inline-flex;\n  gap: 2px;\n  margin: 10px 0 4px;\n  padding: 2px;\n  background: var(--sidebar-bg);\n  border: 1px solid color-mix(in srgb, var(--border-color) 75%, transparent);\n  border-radius: var(--radius-control);\n}\n\n.auth-tab {\n  padding: 4px 12px;\n  border: none;\n  border-radius: var(--radius-small);\n  background: transparent;\n  color: var(--editor-muted);\n  font-size: var(--text-md);\n  cursor: pointer;\n}\n\n.auth-tab:hover {\n  color: var(--editor-text);\n}\n\n.auth-tab-active {\n  background: var(--bg);\n  color: var(--editor-text);\n  font-weight: 500;\n  box-shadow: none;\n}\n\n/* ---- Label + control rows that aren't toggle rows ---- */\n\n.settings-field {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 12px 0;\n}\n\n/* Label on top, then the controls, then their note - for a field whose\n   controls (a model picker and its fetch button) need the row's width. */\n.settings-field-label {\n  font-size: var(--text-md);\n  color: var(--editor-text);\n  flex-shrink: 0;\n}\n\n/* Vertical variant of .settings-field: label + hint stacked over a full-\n   width control (the completion custom prompt textarea). */\n.settings-field-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 10px 0 14px;\n}\n\n/* Proxy setting: type select + host + port on one line. */\n.settings-proxy-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  padding: 0 0 12px;\n}\n\n.settings-proxy-host {\n  flex: 1 1 160px;\n  min-width: 0;\n}\n\n.settings-proxy-port {\n  flex: 0 0 72px;\n}\n\n/* Global skills as read-only rows: /name + description. Managed as files -\n   this list is a mirror, plus the import button above it. */\n.settings-skill-list {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  margin: 0 0 10px;\n  padding: 0;\n  border-top: none;\n}\n\n.settings-skill-item {\n  display: flex;\n  align-items: base