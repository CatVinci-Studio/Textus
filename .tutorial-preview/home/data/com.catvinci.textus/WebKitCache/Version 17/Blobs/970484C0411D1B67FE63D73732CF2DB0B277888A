margin-left: auto;\n  font-size: var(--text-xs);\n  color: var(--editor-accent);\n}\n\n.agent-comment-quote {\n  margin: 0;\n  padding: 0 0 0 8px;\n  border-left: 2px solid var(--review-note-line);\n  font-size: var(--text-sm);\n  color: var(--editor-muted);\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.agent-comment-text {\n  font-size: var(--text-md);\n  line-height: 1.55;\n}\n\n.agent-error-explanation {\n  font-weight: 600;\n}\n\n.agent-error-detail {\n  font-family: var(--editor-mono-font, var(--font-mono));\n  font-size: var(--text-xs);\n  color: var(--editor-muted);\n}\n"
