const __vite__css = "/* QUICK ASK - the in-document chat bar, modeled on VS Code's inline chat.\n   It renders as a block INSIDE the document flow (quick-ask-widget-plugin's\n   zone widget), right after the block it was opened on - content below gets\n   pushed down, never covered, and the panel is never dragged or resized.\n   Reading the full conversation is what the detached WINDOW is for, opened\n   explicitly (the header's pop-out button). Closing is explicit too (the\n   header X or Escape) - never an outside click, since reading the document\n   the chat is about is the most common reason to click away from it. */\n\n/* The chat surfaces' own two tones, set where they are drawn (the editor\n   palette can be redefined below :root): a card a shade off the panel,\n   and the hairline round it. */\n:is(.agent-panel-view, .chat-window, .inline-chat) {\n  --chat-card-bg: color-mix(\n    in srgb,\n    var(--editor-text) 3%,\n    var(--editor-bg, var(--bg))\n  );\n  --chat-hairline: color-mix(\n    in srgb,\n    var(--editor-border, var(--border-color)) 80%,\n    transparent\n  );\n}\n\n.inline-chat {\n  /* A command bar, not a second text column: on a wide adaptive column it\n     stays at a comfortable width, centred under the text it is about,\n     instead of stretching a one-line input and summary past 1000px. */\n  max-width: min(100%, 720px);\n  margin: var(--md-gap-box, 1.1em) auto;\n  /* Room the first text row leaves for the floating header buttons:\n     4px edge + three 22px buttons with 2px gaps, plus 6px of air. Only\n     Quick Ask has them - the detached window shows the same composer with\n     no overlay, so this is scoped to the panel rather than set on the\n     input itself. (It was sized for two buttons after the third, New\n     Conversation, arrived - the input ran under it.) */\n  --quick-ask-actions-width: 80px;\n  /* The panel is portaled INSIDE the editable root, whose base stylesheet\n     sets white-space: pre-wrap; inherited, the newlines between the\n     rendered reply's block elements showed as blank lines. Same fix as\n     .pending-insert. (The textarea and the summary set their own.) */\n  white-space: normal;\n  /* Nor is it document text: no editor line height or caret colour. */\n  line-height: 1.5;\n}\n\n/* A selection that shows in both palettes without shouting: the dark\n   one's default was a dim blue-grey hardly apart from the panel. */\n.inline-chat ::selection {\n  background: color-mix(\n    in srgb,\n    var(--editor-accent) 35%,\n    var(--editor-bg, var(--bg))\n  );\n}\n\n/* It hangs below its paragraph and grows down out of it. */\n.inline-chat:not(.quick-ask-dock) > .inline-chat-shell {\n  transform-origin: top center;\n  animation: quick-ask-in var(--dur-base) var(--ease-out);\n}\n\n@keyframes quick-ask-in {\n  from {\n    opacity: 0;\n    transform: translateY(calc(var(--motion-distance-sm) * -1))\n      scale(calc(var(--scale-enter) + (1 - var(--scale-enter)) * 0.25));\n  }\n}\n\n/* Just the pop-out and close buttons, pinned to the panel's top-right\n   corner. Deliberately slim - this is not a title bar; the panel has no\n   title to show and nothing to grab - and floated rather than given a row\n   of its own, which cost 26px of blank space above the input for the sake\n   of two icons. The input reserves width for them instead (see\n   --quick-ask-actions-width below). */\n.inline-chat-header {\n  position: absolute;\n  top: 0;\n  right: 0;\n  display: flex;\n  align-items: center;\n  padding: 3px 4px;\n}\n\n.inline-chat-header-actions {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  flex-shrink: 0;\n}\n\n.inline-chat-header-button {\n  flex-shrink: 0;\n  font-size: var(--text-xs);\n  line-height: 1;\n}\n\n/* Asked before closing while proposals are still undecided - the previews\n   stay decorated in the document, so closing the surface that explains them\n   without a word would strand them. */\n.inline-chat-confirm {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 8px;\n}\n\n.inline-chat-confirm-message {\n  font-size: var(--text-sm);\n  color: var(--editor-text);\n}\n\n.inline-chat-confirm-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n/* The message list, skill menu and composer all live inside this one\n   bordered/shadowed card - only one .floating-surface for the whole popup,\n   not one per section. Positioned: the header buttons float in its corner. */\n.inline-chat-shell {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n}\n\n/* One rule frames every section boundary inside the shell (messages/\n   skill-menu/composer, in whatever combination is actually mounted) instead\n   of per-pair divider rules. */\n.inline-chat-shell > * + * {\n  border-top: 1px solid var(--editor-border);\n}\n\n/* ...except right below the header, where a rule would just box in two\n   small buttons for no information. */\n.inline-chat-header + * {\n  border-top: none;\n}\n\n.inline-chat-bar {\n  display: flex;\n  flex-direction: column;\n  /* Room between the text and the controls under it, and around both. */\n  gap: 8px;\n  padding: 8px 10px 10px;\n}\n\n.inline-chat-field {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 0;\n}\n\n/* In the panel and the detached window the field is one rounded box on the\n   panel's foot - the text and everything that goes with it (attachments,\n   mode, web search, Send) inside it, lit at its edge while it has focus.\n   Quick Ask is already a card of its own and keeps the open layout. */\n:is(.agent-panel-body, .chat-window-body) .inline-chat-field {\n  gap: 6px;\n  padding: 6px 6px 6px 8px;\n  border: 1px solid var(--editor-border, var(--border-color));\n  border-radius: var(--radius-surface);\n  background: var(--editor-bg, var(--bg));\n  box-shadow: 0 1px 2px rgb(0 0 0 / 4%);\n  transition:\n    border-color var(--dur-fast) var(--ease-standard),\n    box-shadow var(--dur-fast) var(--ease-standard);\n}\n\n:is(.agent-panel-body, .chat-window-body) .inline-chat-field:focus-within {\n  border-color: color-mix(\n    in srgb,\n    var(--editor-accent) 55%,\n    var(--editor-border, var(--border-color))\n  );\n  box-shadow: 0 0 0 3px\n    color-mix(in srgb, var(--editor-accent) 14%, transparent);\n}\n\n:is(.agent-panel-body, .chat-window-body) .inline-chat-input {\n  padding: 2px 2px 0;\n}\n\n/* Inside the box the tools go frameless - one frame (the field's) is\n   enough; the mode reads as a quiet chip, the icons as plain glyphs. */\n:is(.agent-panel-body, .chat-window-body)\n  :is(.inline-chat-attach, .inline-chat-web-search) {\n  border-color: transparent;\n}\n\n:is(.agent-panel-body, .chat-window-body) .inline-chat-web-search.is-active {\n  border-color: transparent;\n}\n\n:is(.agent-panel-body, .chat-window-body) .inline-chat-toolbar {\n  gap: 4px;\n}\n\n:is(.agent-panel-body, .chat-window-body) .ui-select.inline-chat-mode {\n  min-width: 0;\n  border-color: transparent;\n  /* The colour only: the chevron is the background image. */\n  background-color: color-mix(in srgb, var(--editor-text) 6%, transparent);\n}\n\n:is(.agent-panel-body, .chat-window-body)\n  .ui-select.inline-chat-mode:not(:disabled):hover {\n  background-color: color-mix(in srgb, var(--editor-text) 10%, transparent);\n}\n\n/* Input on top (grows with content via the auto-resize effect), tool row\n   below: attach button, the selection chip when text was selected, send. */\n.inline-chat-toolbar {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.inline-chat-mode {\n  min-width: 72px;\n}\n\n/* How much text rides along as context, and a way to drop it. */\n.inline-chat-selection-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: var(--text-xs);\n  color: var(--editor-muted);\n  border: 1px solid var(--editor-border);\n  border-radius: var(--radius-pill);\n  padding: 2px 6px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.inline-chat-chip-remove {\n  display: flex;\n  align-items: center;\n  border: none;\n  background: none;\n  padding: 0;\n  color: inherit;\n  opacity: 0.6;\n  cursor: pointer;\n}\n\n.inline-chat-chip-remove:hover {\n  opacity: 1;\n}\n\n.inline-chat-web-search.is-active {\n  border-color: var(--editor-accent);\n  background: color-mix(in srgb, var(--editor-accent) 14%, transparent);\n  color: var(--editor-accent);\n}\n\n.inline-chat-attachments {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n  padding: 2px 4px 6px;\n}\n\n.inline-chat-attachment {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 2px 6px;\n  border: 1px solid var(--editor-border);\n  border-radius: var(--radius-pill);\n  font-size: var(--text-xs);\n  color: var(--editor-muted);\n}\n\n.inline-chat-attachment-remove {\n  display: flex;\n  align-items: center;\n  border: none;\n  background: transparent;\n  color: var(--editor-muted);\n  cursor: pointer;\n  padding: 0;\n}\n\n/* Document vs image: the two ride to the model in completely different ways\n   (extracted text in the prompt, or a native image part), so the chip says\n   which one this is. */\n.inline-chat-attachment-kind {\n  flex-shrink: 0;\n  width: 12px;\n  height: 12px;\n  opacity: 0.8;\n}\n\n/* Only part of the file reached the model. Said out loud, because a partial\n   answer otherwise looks like the model misread the whole document. */\n.inline-chat-attachment-note {\n  opacity: 0.75;\n  font-style: italic;\n}\n\n/* Why an attachment could not be used. The old code caught and discarded\n   these, which is what made the \"+\" button look dead on a PDF. */\n.inline-chat-attach-error {\n  padding: 4px 8px;\n  font-size: var(--text-xs);\n  color: var(--danger);\n}\n\n/* Skill picker: opens while the input holds a /prefix being typed - a flow\n   section between the messages and the composer, framed by the shell's\n   generic divider rule above. */\n.inline-chat-skill-menu {\n  padding: 4px;\n  max-height: 200px;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  /* Fades in once, when \"/\" opens it; narrowing it as the name is typed\n     changes nothing about it but its rows. */\n  animation: motion-fade-in var(--dur-fast) var(--ease-out);\n}\n\n.inline-chat-skill-item {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  padding: 5px 8px;\n  border: none;\n  border-radius: var(--radius-control);\n  background: transparent;\n  color: var(--editor-text);\n  cursor: pointer;\n  font-size: var(--text-sm);\n  text-align: left;\n  min-width: 0;\n}\n\n.inline-chat-skill-item:hover {\n  background: var(--sidebar-hover);\n}\n\n/* The keyboard's row: the accent's tint, as a selected list row. */\n.inline-chat-skill-item-active {\n  background: color-mix(in srgb, var(--editor-accent) 13%, transparent);\n}\n\n.inline-chat-skill-name {\n  flex-shrink: 0;\n  font-weight: 600;\n}\n\n.inline-chat-skill-preview {\n  color: var(--editor-muted);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n/* ComposerPicker: the list scrolls, the key hint under it stays. */\n.composer-picker {\n  padding: 0;\n  max-height: min(320px, 45vh);\n  overflow: hidden;\n}\n\n.composer-picker-list {\n  position: relative;\n  min-height: 0;\n  overflow-y: auto;\n  padding: 4px;\n  overscroll-behavior: contain;\n}\n\n.composer-picker-group + .composer-picker-group {\n  margin-top: 4px;\n}\n\n.composer-picker-group-title {\n  padding: 8px 8px 3px;\n  color: var(--editor-muted);\n  font-size: var(--text-xs);\n  font-weight: 600;\n  letter-spacing: 0.02em;\n}\n\n/* Label and /name on one line, what it does under them. */\n.composer-picker-item {\n  flex-direction: column;\n  align-items: stretch;\n  gap: 2px;\n  width: 100%;\n  padding: 6px 8px;\n}\n\n.composer-picker-line {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  min-width: 0;\n}\n\n.composer-picker-line .inline-chat-skill-name {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-picker-secondary {\n  flex-shrink: 0;\n  color: var(--editor-muted);\n  font-family: var(--font-mono);\n  font-size: var(--text-xs);\n}\n\n.composer-picker-item .inline-chat-skill-preview {\n  font-size: var(--text-xs);\n}\n\n.composer-picker-keys {\n  flex-shrink: 0;\n  padding: 4px 12px 5px;\n  border-top: 1px solid var(--editor-border);\n  color: var(--editor-muted);\n  font-size: var(--text-xs);\n}\n\n/* Nothing to list: what the key does, and how to get something here. */\n.composer-picker-empty {\n  padding: 9px 12px;\n  color: var(--editor-muted);\n  font-size: var(--text-sm);\n  line-height: 1.5;\n}\n\n.composer-picker-empty p {\n  margin: 0;\n}\n\n.composer-picker-empty p + p {\n  margin-top: 3px;\n}\n\n.composer-picker-empty p:first-child {\n  color: var(--editor-text);\n}\n\n.inline-chat-input {\n  width: 100%;\n  resize: none;\n  border: none;\n  outline: none;\n  background: transparent;\n  color: var(--editor-text);\n  font: inherit;\n  font-size: var(--text-md);\n  /* A WHOLE number of pixels, not a 1.5 ratio: 13 * 1.5 = 19.5px, and the\n     auto-resize effect can only set an integer height, so every line box\n     left the content a half pixel taller than the box it sits in. WebKit\n     took that as a scrollable textarea - permanent scrollbars around an\n     EMPTY input, and a caret painted against a hair of scroll offset. */\n  line-height: 20px;\n  padding: 4px 6px;\n  /* Grows with content via the auto-resize effect, up to ~6 lines. That\n     effect owns overflow-y too, flipping it to auto only once this\n     max-height actually clamps the box - see ChatComposer. */\n  max-height: 120px;\n  overflow-y: hidden;\n  /* A textarea wraps; it has nothing to scroll sideways to. Explicit\n     because `overflow-y` alone would compute the x axis to `auto`\n     (a non-visible axis drags the other one out of `visible` with it),\n     which is where the full-width bar under the placeholder came from. */\n  overflow-x: hidden;\n}\n\n/* The composer is the surface's one field and shows its caret; a ring\n   round it only boxed in the header icons above it (Quick Ask) and the\n   tool row below. */\n.inline-chat-input:focus-visible {\n  outline: none;\n}\n\n/* Whichever section ends up under the floating header buttons keeps clear of\n   them - the composer when the panel is fresh, the reply summary or the\n   pending bar once one of those is on top. Not the composer unconditionally:\n   in the detached window it has no buttons overhead, and here it usually\n   isn't the row they overlap. */\n.inline-chat-header + .inline-chat-bar .inline-chat-input,\n.inline-chat-header + .quick-ask-status,\n.inline-chat-header + .quick-ask-pending-bar,\n.inline-chat-header + .agent-plan-actions,\n.inline-chat-header + .inline-chat-confirm {\n  padding-right: var(--quick-ask-actions-width);\n}\n\n.inline-chat-send {\n  flex-shrink: 0;\n  margin-left: auto;\n}\n\n.inline-chat-messages {\n  padding: 8px 10px;\n  max-height: 280px;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n/* The panel's and the window's conversation: more air between turns, and\n   a step's progress lines kept together under the turn they belong to. */\n:is(.agent-panel-body, .chat-window-body) .inline-chat-messages {\n  gap: 12px;\n  padding: 14px 14px 16px;\n  /* Where scrollbars take room (Linux, Windows), the conversation growing\n     past the panel's height must not narrow and rewrap every turn. */\n  scrollbar-gutter: stable;\n}\n\n:is(.agent-panel-body, .chat-window-body)\n  .inline-chat-messages\n  > :is(:has(> .agent-tool-line, > .agent-tool-result))\n  + :is(:has(> .agent-tool-line, > .agent-tool-result)) {\n  margin-top: -8px;\n}\n\n/* Quick Ask starts as a compact answer preview and can expand in place into\n   the complete transcript. The detached window remains optional. */\n.quick-ask-status {\n  padding: 10px 12px;\n}\n\n/* What was asked, one quiet line above the answer. */\n.quick-ask-prompt {\n  margin-bottom: 4px;\n  overflow: hidden;\n  white-space: nowrap;\n  text-overflow: ellipsis;\n  font-size: var(--text-sm);\n  color: var(--editor-muted);\n}\n\n.quick-ask-summary-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n}\n\n/* The reply at a glance: rendered markdown, cut to a few lines with a\n   fade rather than a hard ellipsis (a line clamp cannot cut through\n   block elements like lists and code). */\n.quick-ask-summary {\n  flex: 1;\n  min-width: 0;\n  max-height: 8.2em;\n  overflow: hidden;\n  font-size: var(--text-md);\n  line-height: 1.6;\n  color: var(--editor-text);\n  -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);\n  mask-image: linear-gradient(to bottom, #000 72%, transparent);\n}\n\n.quick-ask-transcript {\n  max-height: min(52vh, 520px);\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 2px 0;\n  animation: motion-disclose-in var(--dur-base) var(--ease-out);\n}\n\n.quick-ask-more {\n  margin-top: 4px;\n  margin-left: 0;\n  align-self: flex-start;\n}\n\n.agent-plan-actions {\n  display: flex;\n  justify-content: flex-end;\n  padding: 8px;\n}\n\n.inline-chat-action {\n  color: var(--editor-text);\n}\n\n/* One propose_edit tool call from the agent: what it wants to replace (del)\n   and with what (ins). This card is the ONLY place the edit is accepted or\n   rejected, and the only place the before/after is spelled out - the\n   in-document marks show which region changes but carry no detail and no\n   controls of their own. */\n.agent-proposal {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 10px 12px 12px;\n  border: 1px solid var(--chat-hairline, var(--editor-border));\n  border-radius: var(--radius-surface);\n  background: var(--chat-card-bg, transparent);\n  font-size: var(--text-sm);\n  transition: border-color var(--dur-fast) var(--ease-standard);\n}\n\n/* Decided: the card keeps its diff and says what became of it - the edge\n   takes the outcome's colour as the status line fades in. */\n.agent-proposal[data-status=\"accepted\"] {\n  border-color: color-mix(\n    in srgb,\n    var(--success-color) 40%,\n    var(--editor-border)\n  );\n}\n\n/* What it is (an icon and \"Revision · 2 changes\") on the left; the\n   \"+X −Y\" size (the diff toggle) and \"Show in text\" on the right. */\n.agent-proposal-head {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.agent-proposal-icon {\n  flex: none;\n  display: inline-grid;\n  place-items: center;\n  width: 18px;\n  height: 18px;\n  border-radius: 5px;\n  background: color-mix(in srgb, var(--success-color) 14%, transparent);\n  color: var(--success-color);\n}\n\n.agent-proposal-icon svg {\n  width: 11px;\n  height: 11px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2.2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.agent-proposal-head .agent-diff-summary {\n  margin-left: auto;\n}\n\n.agent-proposal-head .agent-diff-summary + .agent-proposal-show {\n  margin-left: 4px;\n}\n\n.agent-proposal-title {\n  min-width: 0;\n}\n\n.agent-proposal-kind {\n  font-weight: 500;\n}\n\n.agent-proposal .agent-proposal-show {\n  margin-left: auto;\n  padding-left: 4px;\n  white-space: nowrap;\n  align-self: center;\n  font-size: var(--text-xs);\n  color: var(--editor-accent);\n}\n\n.agent-proposal-title {\n  font-size: var(--text-xs);\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  color: var(--editor-muted);\n}\n\n/* Line-by-line diff, read like a code review: a +/- gutter, monospace so\n   markdown syntax lines up, and tinted rows. Monospace matters here - the\n   whole point of showing markdown source is that `##` and `**` are visible,\n   and a proportional font hides how they align. */\n.agent-proposal-diff {\n  display: flex;\n  flex-direction: column;\n  padding: 4px 0;\n  border: 1px solid var(--chat-hairline, var(--editor-border));\n  border-radius: var(--radius-block);\n  background: var(--editor-bg, var(--bg));\n  overflow: hidden;\n  animation: motion-disclose-in var(--dur-fast) var(--ease-out);\n  font-family: var(--editor-mono-font, var(--font-mono));\n  font-size: var(--text-sm);\n  line-height: 1.5;\n}\n\n.agent-diff-line {\n  display: flex;\n  gap: 6px;\n  padding: 1px 8px;\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n.agent-diff-marker {\n  flex-shrink: 0;\n  width: 0.6em;\n  opacity: 0.55;\n  user-select: none;\n}\n\n.agent-diff-text {\n  flex: 1;\n  min-width: 0;\n}\n\n.agent-diff-context {\n  color: var(--editor-muted);\n}\n\n.agent-diff-remove {\n  background: var(--diff-delete-bg);\n  color: var(--editor-text);\n}\n\n.agent-diff-add {\n  background: var(--diff-insert-bg);\n  color: var(--editor-text);\n}\n\n/* The size chips double as the full diff's toggle - the document already\n   paints the change itself, so the card shows it only on demand. */\n.agent-diff-summary {\n  align-self: center;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  flex-shrink: 0;\n  border: none;\n  background: none;\n  padding: 2px 0;\n  font-family: var(--editor-mono-font, var(--font-mono));\n  font-size: var(--text-xs);\n  cursor: pointer;\n  color: var(--editor-muted);\n}\n\n.agent-diff-chip {\n  padding: 1px 6px;\n  line-height: 1.4;\n  border-radius: var(--radius-pill);\n  /* Counts change in place without their digits shifting. */\n  font-variant-numeric: tabular-nums;\n}\n\n.agent-diff-caret {\n  width: 0;\n  height: 0;\n  margin-left: 2px;\n  border-left: 4px solid currentColor;\n  border-top: 3.5px solid transparent;\n  border-bottom: 3.5px solid transparent;\n  transition: transform var(--dur-fast) var(--ease-standard);\n}\n\n.agent-diff-summary[aria-expanded=\"true\"] .agent-diff-caret {\n  transform: rotate(90deg);\n}\n\n.agent-diff-summary:hover {\n  color: var(--editor-text);\n}\n\n.agent-proposal button {\n  align-self: flex-start;\n}\n\n/* Once resolved (status !== \"pending\"), the buttons give way to a compact\n   status line; the diff above stays, so scrolling back through a\n   conversation still shows what each accepted edit actually did. */\n.agent-proposal-status {\n  font-size: var(--text-sm);\n  color: var(--editor-muted);\n  animation: motion-fade-in var(--dur-fast) var(--ease-out);\n}\n\n/* Not decidable yet - arguments still streaming or the typewriter still\n   revealing the text in the document. */\n.agent-proposal-status-streaming {\n  font-style: italic;\n}\n\n.agent-proposal-status-accepted {\n  color: var(--editor-accent);\n}\n\n.agent-proposal-status-rejected {\n  opacity: 0.7;\n}\n\n.agent-proposal-status-invalid {\n  color: var(--danger);\n}\n\n.agent-proposal-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 6px;\n  margin-top: 2px;\n}\n\n/* Secondary, text-only controls at the end of a card's action row. */\n.agent-proposal-link {\n  margin-left: auto;\n  border: none;\n  background: none;\n  padding: 2px 0;\n  font: inherit;\n  font-size: var(--text-sm);\n  color: var(--editor-muted);\n  cursor: pointer;\n}\n\n.agent-proposal-link:hover,\n.agent-proposal-link[aria-expanded=\"true\"] {\n  color: var(--editor-text);\n}\n\n.agent-proposal-link:hover {\n  text-decoration: underline;\n}\n\n/* Pinned above the composer whenever anything is undecided. The cards\n   themselves scroll away in a long conversation, and edits sitting\n   unresolved in the document with nothing on screen saying so is how they\n   get forgotten. It rises out from behind the composer with the first\n   edit and goes back behind it after the last; its count changes in\n   place. */\n.inline-chat-pending-bar {\n  animation: pending-bar-in var(--dur-base) var(--ease-out);\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 4px 8px;\n  padding: 6px 10px 6px 14px;\n  font-size: var(--text-sm);\n  color: var(--editor-text);\n  /* Over the panel's own colour rather than see-through: on the phone the\n     sheet's composer area passes over the message list while it moves. */\n  background: color-mix(\n    in srgb,\n    var(--editor-accent) 10%,\n    var(--editor-bg, var(--bg))\n  );\n}\n\n.inline-chat-pending-bar[data-state=\"closing\"] {\n  animation: pending-bar-out var(--dur-fast) var(--ease-in) forwards;\n}\n\n/* What follows the bar paints over it while it moves. */\n.inline-chat-pending-bar\n  ~ :is(.inline-chat-bar, .inline-chat-skill-menu, .agent-plan-actions) {\n  position: relative;\n  background: var(--editor-bg, var(--bg));\n}\n\n@keyframes pending-bar-in {\n  from {\n    opacity: var(--motion-travel-fade);\n    transform: translateY(calc(100% * var(--motion-travel)));\n  }\n}\n\n@keyframes pending-bar-out {\n  to {\n    opacity: var(--motion-travel-fade);\n    transform: translateY(calc(100% * var(--motion-travel)));\n  }\n}\n\n/* The buttons drop to a second line before the label gets squeezed into\n   a word per line (longer languages, a narrow panel). */\n.inline-chat-pending-count {\n  flex: 1 1 10em;\n  font-weight: 500;\n  /* Counts change in place without their digits shifting. */\n  font-variant-numeric: tabular-nums;\n}\n\n.inline-chat-pending-actions {\n  display: flex;\n  gap: 4px;\n  flex-shrink: 0;\n}\n\n.inline-chat-pending-actions .inline-chat-action {\n  padding: 2px 8px;\n  font-size: var(--text-sm);\n}\n\n/* Quick Ask's review-one-at-a-time bar (QuickAskPendingBar.tsx) - the ONE\n   control surface for edits in this surface, so it gets the same pinned\n   treatment as the full variant's bar above. */\n.quick-ask-pending-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 5px 8px;\n  font-size: var(--text-sm);\n  color: var(--editor-text);\n  background: color-mix(in srgb, var(--editor-accent) 10%, transparent);\n}\n\n.quick-ask-pending-nav {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  min-width: 0;\n}\n\n.quick-ask-pending-nav-button {\n  flex-shrink: 0;\n  font-size: var(--text-md);\n  line-height: 1;\n}\n\n.quick-ask-pending-position {\n  font-variant-numeric: tabular-nums;\n  color: var(--editor-muted);\n  white-space: nowrap;\n}\n\n.quick-ask-pending-actions {\n  display: flex;\n  gap: 4px;\n  flex-shrink: 0;\n}\n\n/* Split button: a primary action plus a chevron that opens a one-item menu\n   for the bulk variant of the same action (\"Accept\" -> \"Accept all (N)\"). */\n.quick-ask-split-button {\n  position: relative;\n  display: flex;\n}\n\n.quick-ask-split-main {\n  border-top-right-radius: 0;\n  border-bottom-right-radius: 0;\n}\n\n.quick-ask-split-chevron {\n  padding: 4px 5px;\n  border-left: none;\n  border-top-left-radius: 0;\n  border-bottom-left-radius: 0;\n  margin-left: -1px;\n}\n\n.quick-ask-split-chevron-icon {\n  transform: rotate(90deg);\n  opacity: 0.7;\n}\n\n.quick-ask-split-menu {\n  position: absolute;\n  top: calc(100% + 4px);\n  right: 0;\n  z-index: 10;\n  white-space: nowrap;\n  transform-origin: top right;\n  animation: motion-pop-in var(--dur-base) var(--ease-out);\n}\n\n.quick-ask-split-menu[data-state=\"closing\"] {\n  animation: motion-pop-out var(--dur-fast) var(--ease-in) forwards;\n}\n\n.quick-ask-split-menu-item {\n  display: block;\n  width: 100%;\n}\n\n/* Busy indicator: no token streaming (the reply arrives all at once), so\n   this is deliberately honest about that - a label plus three staggered\n   pulsing dots, not a fake progress bar. */\n.agent-thinking {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: var(--text-sm);\n  color: var(--editor-muted);\n}\n\n.agent-thinking-dots {\n  display: inline-flex;\n  gap: 3px;\n}\n\n.agent-thinking-dots span {\n  width: 4px;\n  height: 4px;\n  border-radius: 50%;\n  background: currentColor;\n  animation: agent-thinking-pulse 1.2s ease-in-out infinite;\n}\n\n.agent-thinking-dots span:nth-child(2) {\n  animation-delay: 0.2s;\n}\n\n.agent-thinking-dots span:nth-child(3) {\n  animation-delay: 0.4s;\n}\n\n@keyframes agent-thinking-pulse {\n  0%,\n  80%,\n  100% {\n    opacity: 0.25;\n  }\n  40% {\n    opacity: 1;\n  }\n}\n\n/* Prose still arriving ends in a soft caret, so a pause between tokens\n   reads as \"still writing\" rather than as the end of the answer. Not after\n   a list, a code block or a table, where it would sit on a line of its\n   own. */\n.agent-streaming\n  .agent-markdown\n  > :last-child:not(ul, ol, pre, table, .agent-math)::after {\n  content: \"\";\n  display: inline-block;\n  width: 2px;\n  height: 1.05em;\n  margin-left: 2px;\n  vertical-align: -0.15em;\n  border-radius: 1px;\n  background: var(--editor-accent);\n  animation: agent-caret-pulse 1s var(--ease-standard) infinite;\n}\n\n@keyframes agent-caret-pulse {\n  50% {\n    opacity: 0.2;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .agent-streaming .agent-markdown > :last-child::after {\n    animation: none;\n  }\n}\n\n/* A reply lands all at once, not token by token - this staggers each new\n   turn's entrance instead of the whole batch appearing as one flat block.\n   --reveal-delay is set per-turn inline (see ChatMessages.tsx). Streamed\n   text itself never animates: each token appearing on its own would make\n   the reply unreadable while it arrives. */\n.turn-reveal {\n  animation: turn-reveal-in var(--dur-base) var(--ease-out) both;\n  animation-delay: var(--reveal-delay, 0ms);\n}\n\n@keyframes turn-reveal-in {\n  from {\n    opacity: 0;\n    transform: translateY(var(--motion-distance-sm));\n  }\n}\n\n/* A proposed edit arrives as a card: it also grows out of its top edge. */\n.agent-proposal.turn-reveal {\n  transform-origin: top center;\n  animation-name: proposal-reveal-in;\n}\n\n@keyframes proposal-reveal-in {\n  from {\n    opacity: 0;\n    transform: translateY(var(--motion-distance-sm))\n      scale(var(--scale-enter-dialog));\n  }\n}\n\n/* Quick Ask lives inside the editor's .milkdown root, so the DOCUMENT's\n   element styles reach the rendered replies too: drawn list bullets tuned\n   to the document's 1.8 line height, the h2 rule and h3 bar, the h4 dot,\n   tinted quotes, centred block images, full-width tables. A reply is chat\n   text, so they are undone here - prefixed to outrank the .milkdown rules,\n   whatever order the stylesheets load in. (The detached window has no\n   .milkdown around it and never needed this.) */\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown p {\n  margin: 0.5em 0;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown li {\n  position: static;\n  counter-increment: none;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown ul > li {\n  list-style: disc;\n}\n\n.inline-chat\n  :is(.agent-message, .quick-ask-summary)\n  .agent-markdown\n  ul\n  ul\n  > li {\n  list-style: circle;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown ol > li {\n  list-style: decimal;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown li::before,\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown li::after,\n.inline-chat\n  :is(.agent-message, .quick-ask-summary)\n  .agent-markdown\n  h4::before {\n  content: none;\n  display: none;\n}\n\n.inline-chat\n  :is(.agent-message, .quick-ask-summary)\n  .agent-markdown\n  li:has(> input[type=\"checkbox\"]) {\n  list-style: none;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown h2,\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown h3 {\n  padding: 0;\n  border: none;\n}\n\n.inline-chat\n  :is(.agent-message, .quick-ask-summary)\n  .agent-markdown\n  blockquote {\n  margin: 0.5em 0;\n  padding: 0 0 0 8px;\n  border-left: 2px solid var(--editor-border);\n  border-radius: 0;\n  background: none;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown img {\n  display: inline;\n  margin: 0;\n  box-shadow: none;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown table {\n  width: auto;\n  table-layout: auto;\n  margin: 0.5em 0;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown pre {\n  margin: 0.5em 0;\n  padding: 6px 8px;\n  font-size: 0.92em;\n  line-height: 1.5;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown hr {\n  margin: 0.8em 0;\n  border-top: 1px solid var(--editor-border);\n  opacity: 1;\n}\n\n.inline-chat\n  :is(.agent-message, .quick-ask-summary)\n  .agent-markdown\n  :is(h1, h2, h3, h4, h5, h6) {\n  margin: 0.9em 0 0.35em;\n  line-height: 1.35;\n  font-size: 1em;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown h1 {\n  font-size: 1.3em;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown h2 {\n  font-size: 1.18em;\n}\n\n.inline-chat :is(.agent-message, .quick-ask-summary) .agent-markdown h3 {\n  font-size: 1.08em;\n}\n\n/* Proposal card: the model's one-line reason, and the per-sentence choice\n   list (ChatMessages' ProposalCard). */\n.agent-proposal-reason {\n  font-size: var(--text-md);\n  line-height: 1.5;\n  color: var(--editor-text);\n}\n\n/* The changed sentences, numbered as the text marks them, each with the\n   ✓ / ✕ it also has in the document: one decision, two places to make it.\n   A kept sentence shows its original, dimmed. */\n.agent-proposal-sentences {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.agent-proposal-sentences > li {\n  display: flex;\n  align-items: flex-start;\n  gap: 6px;\n  padding: 5px 6px 5px 4px;\n  border-radius: var(--radius-block);\n  transition: background var(--dur-fast) var(--ease-standard);\n}\n\n.agent-proposal-sentences > li:hover {\n  background: color-mix(in srgb, var(--editor-text) 4%, transparent);\n}\n\n.agent-proposal .agent-proposal-sentence {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n  border: 0;\n  background: none;\n  padding: 0;\n  font: inherit;\n  font-size: var(--text-sm);\n  line-height: 1.5