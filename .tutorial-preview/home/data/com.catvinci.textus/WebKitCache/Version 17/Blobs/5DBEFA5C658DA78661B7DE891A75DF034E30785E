const __vite__css = "/* Every phone and tablet style in one place. The desktop stylesheets are\n   written for a mouse and stay as they are; these files hold the whole\n   difference, layered on top.\n\n   The rules:\n   - Every selector starts with :root[data-window-chrome=\"mobile\"]\n     (platform/window-chrome.ts sets it on iOS). That prefix is also what makes\n     an override win: it outranks the desktop rule it replaces on\n     specificity, so nothing here depends on load order - the editor's own\n     stylesheets arrive later, in its lazily loaded chunk.\n   - Rules for any touch (iPhone and iPad) sit at the top level; phone\n     forms - drawer, sheets, docked Quick Ask, full-screen settings - sit\n     inside @media (max-width: 760px), the width usePhoneLayout()\n     (ui/usePhoneLayout.ts) switches the components at.\n   - One file per area, below. A component that exists only on the phone\n     (ActionSheet, PhoneNavBar, KeyboardToolbar, DocumentList) keeps its\n     stylesheet beside it instead. */\n/* The phone layout's foundation: the tokens, fonts and title row every\n   other file in mobile/styles/ builds on, and the rules that hold for any\n   touch (iPhone and iPad alike). See index.css for how these files are\n   organised. */\n\n/* iOS WebKit: -apple-system / system-ui / ui-monospace render Chinese and\n   Japanese as missing-glyph boxes, and a family that isn't installed (Fira\n   Code, SF Pro) sends Latin to Times instead of the next font in the list.\n   Single generic families cascade to PingFang correctly, so iOS gets\n   stacks made only of fonts it has. */\n/* The Slate and Forest content themes lead with -apple-system too. */\n:root[data-window-chrome=\"mobile\"]:is(\n    [data-content-theme=\"slate\"],\n    [data-content-theme=\"forest\"]\n  ) {\n  --editor-font: sans-serif;\n}\n\n:root[data-window-chrome=\"mobile\"] {\n  --font-sans: sans-serif;\n  --font-mono: Menlo, monospace;\n  --mobile-bar: 44px;\n  /* The document's background, resolved here at the root: inside the\n     chrome (.window-bar and the rest, design-system.css) --editor-bg is\n     re-bound to the chrome's own colour. */\n  --page-bg: var(--editor-bg, var(--bg));\n  /* No grey flash over whatever a finger lands on. */\n  -webkit-tap-highlight-color: transparent;\n  /* Phone-only layers. A full-screen page (Settings, Documents) covers\n     the find bar (300) and the app menu (310) but stays under the alerts\n     it asks its own questions with (400-450) - Delete, Clear. An action\n     sheet (ui/ActionSheet.tsx) is over everything. */\n  --z-phone-page: 350;\n  --z-sheet-menu: 500;\n}\n\n/* 16px is the least WebKit will show a focused field at without zooming\n   the page in, and the size iOS sets its own fields in. */\n:root[data-window-chrome=\"mobile\"]\n  :is(input:not([type=\"checkbox\"], [type=\"radio\"], [type=\"range\"]), textarea) {\n  font-size: max(16px, 1em);\n}\n\n/* The strips under the status bar and the home indicator are page\n   background: the document's, not the chrome's, so the page runs to both\n   edges of the screen. */\n:root[data-window-chrome=\"mobile\"] body {\n  background: var(--page-bg);\n}\n\n/* The web view shrinks while the keyboard is up (KeyboardFit.swift); 100%\n   follows it where 100vh might not. */\n:root[data-window-chrome=\"mobile\"] .app-shell {\n  height: 100%;\n}\n\n/* Title row: 44pt, Apple's minimum touch target, with the menu at the left\n   edge (no traffic lights to make room for) and the AI toggle at the right. */\n:root[data-window-chrome=\"mobile\"] .window-bar {\n  height: var(--mobile-bar);\n  padding: 0 4px;\n  /* One surface from the status bar down through the page. */\n  background: var(--page-bg);\n}\n\n:root[data-window-chrome=\"mobile\"] .window-menu-button,\n:root[data-window-chrome=\"mobile\"] .window-bar-toggle {\n  width: 44px;\n  height: 44px;\n  border-radius: var(--radius-control);\n}\n\n/* A touch leaves :hover stuck on the last thing tapped. */\n:root[data-window-chrome=\"mobile\"] .window-menu-button:hover {\n  background: none;\n}\n\n:root[data-window-chrome=\"mobile\"]\n  .window-bar-toggle:hover:not(.window-bar-toggle-on) {\n  background: none;\n}\n\n/* On, it takes the tint as an iOS bar button does, rather than a filled\n   box flush against the screen's edge. */\n:root[data-window-chrome=\"mobile\"] .window-bar-toggle-on {\n  background: none;\n  color: var(--chrome-accent);\n}\n\n/* Focus rings are for finding your place with a keyboard. A finger knows\n   where it is, and WebKit counts a focus the app moves itself (a dialog's\n   first button, the sheet's grip) as \"visible\" - an accent box around\n   whatever was just tapped. Text fields keep their own focused border. */\n@media (pointer: coarse) {\n  :root[data-window-chrome=\"mobile\"] :focus-visible {\n    outline: none;\n  }\n}\n\n/* The desktop's 12-14px glyphs read as specks in a 44pt button; iOS draws\n   bar and toolbar symbols at about 20pt. */\n:root[data-window-chrome=\"mobile\"]\n  :is(.window-menu-button, .window-bar-toggle, .agent-panel-actions button)\n  svg {\n  width: 20px;\n  height: 20px;\n}\n\n/* The web view stops at the safe area, so the strips under the status bar\n   and the home indicator show the body's background, not the page. While\n   something covers the page they take its colour, as a native sheet or\n   dimming view reaches the screen's edges: a full-screen page's own\n   background, or the page darkened by the scrim over it. WebKit paints\n   those strips from the background COLOUR alone, so each scrim's\n   translucent colour is pre-mixed over the page here (--overlay-bg is\n   30% navy in light themes, 48% black in dark - design-system.css). A\n   surface on its way out (data-state=\"closing\") gives them back at once. */\n:root[data-window-chrome=\"mobile\"] {\n  --phone-dim-overlay: color-mix(in srgb, var(--page-bg) 70%, rgb(20 27 40));\n}\n\n@media (prefers-color-scheme: dark) {\n  :root[data-window-chrome=\"mobile\"]:not([data-theme=\"light\"]) {\n    --phone-dim-overlay: color-mix(in srgb, var(--page-bg) 52%, black);\n  }\n}\n\n:root[data-window-chrome=\"mobile\"][data-theme=\"dark\"] {\n  --phone-dim-overlay: color-mix(in srgb, var(--page-bg) 52%, black);\n}\n\n/* Settings fills the phone's screen (settings.css) with iOS's grouped\n   page colour - #f2f2f7, black in dark - which the strips take too; they\n   were left the document's white (or its dark grey). On an iPad it is a\n   dialog over the dimmed page. */\n@media (max-width: 760px) {\n  :root[data-window-chrome=\"mobile\"]:has(\n      .settings-backdrop:not([data-state=\"closing\"])\n    )\n    body {\n    background: var(--grouped-page);\n  }\n}\n\n@media (min-width: 761px) {\n  :root[data-window-chrome=\"mobile\"]:has(\n      .settings-backdrop:not([data-state=\"closing\"])\n    )\n    body {\n    background: var(--phone-dim-overlay);\n  }\n}\n\n/* The first-launch language card and the tutorial dim the whole screen,\n   strips included. */\n:root[data-window-chrome=\"mobile\"]:has(\n    :is(.language-welcome-backdrop, .tutorial-backdrop):not(\n      [data-state=\"closing\"]\n    )\n  )\n  body {\n  background: var(--phone-dim-overlay);\n}\n\n/* The drawer's scrim is drawn at phone width only (sidebar.css). */\n@media (max-width: 760px) {\n  :root[data-window-chrome=\"mobile\"]:has(\n      .sidebar-scrim:not([data-state=\"closing\"])\n    )\n    body {\n    background: color-mix(in srgb, var(--page-bg) 75%, black);\n  }\n}\n\n:root[data-window-chrome=\"mobile\"]:has(\n    .close-prompt-overlay:not([data-state=\"closing\"])\n  )\n  body {\n  background: var(--phone-dim-overlay);\n}\n\n:root[data-window-chrome=\"mobile\"]:has(\n    .action-sheet-scrim:not([data-state=\"closing\"])\n  )\n  body {\n  background: color-mix(in srgb, var(--page-bg) 70%, black);\n}\n/* The sidebar on a phone: a drawer over the page rather than a column\n   beside it, with rows a finger can hit. */\n\n/* Everything that cleared the desktop's 28px row clears this one. */\n:root[data-window-chrome=\"mobile\"] .sidebar-header {\n  padding-top: calc(var(--mobile-bar) + 10px);\n}\n\n@media (max-width: 760px) {\n  /* The sidebar slides over the page instead of narrowing it; the scrim\n     behind it closes it on a tap. Both cover the title row (45) too, as a\n     drawer covers the whole screen: the dimming then reaches the status\n     bar strip (base.css) in one piece. */\n  :root[data-window-chrome=\"mobile\"] .sidebar {\n    position: fixed;\n    z-index: 47;\n    width: min(320px, 85vw);\n    box-shadow: var(--shadow-drawer);\n  }\n\n  /* A drawer: the page keeps its width under it (app/sidebar-frame.css's chain, with\n     the prefix on top to outrank it). */\n  :root[data-window-chrome=\"mobile\"]:not(.zen)\n    .sidebar:not(.sidebar-collapsed)\n    ~ .main-pane {\n    margin-left: 0;\n  }\n\n  /* The scrim fades with the drawer's slide. */\n  :root[data-window-chrome=\"mobile\"] .sidebar-scrim {\n    position: fixed;\n    inset: 0;\n    z-index: 46;\n    background: rgb(0 0 0 / 0.25);\n    animation: motion-fade-in var(--dur-slow) var(--ease-standard);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .sidebar-scrim[data-state=\"closing\"] {\n    animation: motion-fade-out var(--dur-base) var(--ease-in) forwards;\n  }\n}\n\n/* Wider than a phone the sidebar is docked, so there is nothing to tap\n   beside it. */\n@media (min-width: 761px) {\n  :root[data-window-chrome=\"mobile\"] .sidebar-scrim {\n    display: none;\n  }\n}\n\n/* A tap leaves :hover on the row until something else is touched. */\n:root[data-window-chrome=\"mobile\"] .tree-row:hover:not(.tree-row-active) {\n  background: none;\n}\n\n/* A long press on a file opens Textus's own menu (FileTree.tsx), not the\n   system's link callout, and doesn't select the label. */\n:root[data-window-chrome=\"mobile\"] .tree-row {\n  -webkit-touch-callout: none;\n  -webkit-user-select: none;\n  user-select: none;\n}\n\n/* Rows and tabs a finger can hit (an iPad's too). */\n:root[data-window-chrome=\"mobile\"] :is(.tree-row, .sidebar-tab) {\n  min-height: 44px;\n}\n\n:root[data-window-chrome=\"mobile\"] .sidebar-tab {\n  min-width: 44px;\n}\n\n:root[data-window-chrome=\"mobile\"] .sidebar-tab:hover:not(.sidebar-tab-active) {\n  background: none;\n}\n/* The iPhone's forms of the app's dialogs, menus and bars: an alert in the\n   middle of the screen, a pull-down menu, a find bar across the top, a tab\n   row a thumb can scroll. The first rules hold for any touch (iPad too);\n   the rest are phone width only. */\n\n:root[data-window-chrome=\"mobile\"] :is(.app-menu-item, .context-menu-item) {\n  min-height: 44px;\n}\n\n/* With 44pt rows and the recent documents, the phone menu is taller than\n   the desktop's 560px cap; it may use the screen below the title row. */\n:root[data-window-chrome=\"mobile\"] .app-menu-list {\n  max-height: calc(100vh - var(--mobile-bar) - 24px);\n}\n\n:root[data-window-chrome=\"mobile\"] .tab-bar {\n  padding-top: calc(var(--mobile-bar) + 6px);\n}\n\n:root[data-window-chrome=\"mobile\"]\n  :is(\n    .settings-backdrop,\n    .tutorial-backdrop,\n    .insert-table-overlay,\n    .image-name-overlay,\n    .close-prompt-overlay\n  ) {\n  /* The whole screen: on iOS the title row has no window to drag or\n     close (app/window-bar.css keeps the desktop's clear), and an iPad's Settings\n     left it bright and live above the dimming. */\n  top: 0;\n}\n\n@media (max-width: 760px) {\n  /* ---- Alerts (ui/app-dialog.tsx): UIAlertController's card. ---- */\n\n  /* An alert takes the whole screen, title row included: nothing behind\n     it answers until it is dismissed. */\n  :root[data-window-chrome=\"mobile\"] .close-prompt-overlay {\n    top: 0;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .app-dialog {\n    width: 270px;\n    min-width: 0;\n    max-width: calc(100vw - 32px);\n    padding: 0;\n    overflow: hidden;\n    border: none;\n    border-radius: var(--radius-dialog);\n    text-align: center;\n    animation: motion-alert-in var(--dur-medium) var(--ease-out);\n  }\n\n  /* Dismissed, it only fades - with the dimming behind it. */\n  :root[data-window-chrome=\"mobile\"]\n    .close-prompt-overlay[data-state=\"closing\"]\n    > .app-dialog {\n    animation: none;\n  }\n\n  /* The title is the alert's question, not a coloured label: iOS never\n     tints it, a destructive answer is shown on its button instead. */\n  :root[data-window-chrome=\"mobile\"] .app-dialog-title {\n    margin: 0;\n    padding: 19px 16px 0;\n    color: var(--editor-text);\n    font-size: var(--ios-body);\n    font-weight: 600;\n    line-height: 1.3;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .app-dialog p {\n    margin: 0;\n    padding: 4px 16px 19px;\n    font-size: var(--ios-footnote);\n    line-height: 1.4;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .app-dialog > p:first-child {\n    padding-top: 19px;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .app-dialog-input {\n    width: calc(100% - 32px);\n    min-height: 36px;\n    margin: -7px 16px 16px;\n    text-align: left;\n  }\n\n  /* Answers are rows of text divided by hairlines: two side by side,\n     more stacked. */\n  :root[data-window-chrome=\"mobile\"] .app-dialog .close-prompt-buttons {\n    align-items: stretch;\n    gap: 0;\n    border-top: 1px solid var(--editor-border);\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    .app-dialog\n    .close-prompt-buttons:has(> button:nth-of-type(3)) {\n    flex-direction: column;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .app-dialog .close-prompt-spacer {\n    display: none;\n  }\n\n  /* .close-prompt in the chain outranks the shared button styles' primary\n     and hover rules (design-system.css). */\n  :root[data-window-chrome=\"mobile\"]\n    .app-dialog.close-prompt\n    .close-prompt-buttons\n    button {\n    flex: 1 1 0;\n    min-width: 0;\n    min-height: 44px;\n    margin: 0;\n    padding: 0 8px;\n    border: none;\n    border-radius: 0;\n    background: none;\n    color: var(--editor-accent);\n    font-size: var(--ios-body);\n    font-weight: 400;\n    opacity: 1;\n    /* iOS's highlight: on at the touch, fading out after it. */\n    transition: background-color var(--dur-base) var(--ease-standard);\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    .app-dialog.close-prompt\n    .close-prompt-buttons\n    button:active {\n    background: color-mix(in srgb, var(--editor-text) 8%, transparent);\n    transition-duration: 0s;\n  }\n\n  /* .close-prompt here too, or the buttons' own `border: none` above won\n     and Cancel and Delete ran together with no hairline between them. */\n  :root[data-window-chrome=\"mobile\"]\n    .app-dialog.close-prompt\n    .close-prompt-buttons\n    button\n    + button {\n    border-left: 1px solid var(--editor-border);\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    .app-dialog.close-prompt\n    .close-prompt-buttons:has(> button:nth-of-type(3))\n    button\n    + button {\n    border-top: 1px solid var(--editor-border);\n    border-left: none;\n  }\n\n  /* The answer the alert expects is the bold one. */\n  :root[data-window-chrome=\"mobile\"]\n    .app-dialog.close-prompt\n    .close-prompt-buttons\n    button.close-prompt-primary {\n    font-weight: 600;\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    .app-dialog.close-prompt\n    .close-prompt-buttons\n    button.app-dialog-danger {\n    color: var(--danger);\n  }\n\n  /* ---- The title row's menu (app/AppMenu.tsx): a pull-down menu. ---- */\n\n  /* UIMenu's width, grown for a longer label (French \"Rechercher et\n     remplacer…\" ellipsized at 250px); a recent document's long name still\n     ellipsizes at the cap. */\n  :root[data-window-chrome=\"mobile\"] .app-menu-list {\n    width: max-content;\n    min-width: 250px;\n    max-width: min(320px, calc(100vw - 16px));\n    padding: 0;\n    border-radius: var(--radius-dialog);\n  }\n\n  /* Out of the menu button on a spring, as UIMenu opens. */\n  :root[data-window-chrome=\"mobile\"] .app-menu > .app-menu-list {\n    animation-duration: var(--dur-medium);\n    animation-timing-function: var(--ease-spring);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .app-menu-item {\n    position: relative;\n    min-height: 44px;\n    padding: 0 16px;\n    border-radius: 0;\n    font-size: var(--ios-body);\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    .app-menu-row\n    + .app-menu-row\n    > .app-menu-item {\n    border-top: 1px solid var(--editor-border);\n  }\n\n  /* Groups are set apart by a band, as UIMenu draws its sections. */\n  :root[data-window-chrome=\"mobile\"] .app-menu-separator {\n    height: 8px;\n    margin: 0;\n    background: color-mix(in srgb, var(--editor-text) 6%, transparent);\n  }\n\n  /* The check of an on/off row sits at the trailing edge, as on the\n     desktop menus; a little larger, for the 17pt row. */\n  :root[data-window-chrome=\"mobile\"] .app-menu-check {\n    width: 20px;\n    height: 20px;\n    margin-left: 0;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .app-menu-check svg {\n    width: 17px;\n    height: 17px;\n  }\n\n  /* A tap leaves :hover on the row it lifted from; a row lights only\n     while pressed. */\n  :root[data-window-chrome=\"mobile\"]\n    .app-menu-item:not(:disabled):is(:hover, :focus-visible) {\n    background: none;\n  }\n\n  /* iOS's highlight: on at the touch, fading out after it. */\n  :root[data-window-chrome=\"mobile\"] .app-menu-item {\n    transition: background-color var(--dur-base) var(--ease-standard);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .app-menu-item:not(:disabled):active {\n    background: color-mix(in srgb, var(--editor-text) 8%, transparent);\n    transition-duration: 0s;\n  }\n\n  /* ---- Find and replace (editor/find/FindReplaceBar.tsx): a bar across the\n     top, under the title row, rather than a card in the corner. ---- */\n\n  :root[data-window-chrome=\"mobile\"] .find-replace-bar {\n    top: var(--mobile-bar);\n    right: 0;\n    left: 0;\n    gap: 0;\n    padding: 0 4px;\n    border: none;\n    border-bottom: 1px solid var(--border-color);\n    border-radius: 0;\n    box-shadow: none;\n    background: var(--page-bg);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .find-replace-row {\n    min-height: 44px;\n    gap: 2px;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .find-replace-chevron,\n  :root[data-window-chrome=\"mobile\"] .find-replace-chevron-spacer {\n    width: 40px;\n    height: 44px;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .find-replace-field {\n    min-height: 36px;\n    padding: 0 4px 0 8px;\n    border: none;\n    border-radius: var(--radius-surface);\n    background: color-mix(in srgb, var(--editor-text) 7%, transparent);\n  }\n\n  /* The grey field is the input's edge; the input itself draws none. */\n  :root[data-window-chrome=\"mobile\"] .find-replace-input {\n    border: none;\n    outline: none;\n    background: transparent;\n    box-shadow: none;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .find-replace-toggle {\n    width: 30px;\n    height: 30px;\n    font-size: var(--ios-caption) !important;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .find-replace-nav {\n    gap: 0;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .find-replace-nav button {\n    min-width: 44px;\n    height: 44px;\n    border: none;\n  }\n\n  /* Replace and Replace All: text buttons, as in a toolbar. */\n  :root[data-window-chrome=\"mobile\"] .find-replace-nav button:not(:has(svg)) {\n    padding: 0 8px;\n    color: var(--editor-accent);\n    font-size: var(--ios-subhead);\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    .find-replace-bar\n    button:hover:not(:disabled) {\n    background: none;\n  }\n\n  /* ---- The AI notice toast (MilkdownEditor's showAiNotice) ---- */\n\n  /* Clear of the keyboard toolbar (44px, mobile/KeyboardToolbar.css) while\n     a document is being edited, and of the home indicator when it isn't.\n     One height for both: telling them apart would mean watching the\n     toolbar come and go, and a toast a little high is still readable. */\n  :root[data-window-chrome=\"mobile\"] .ai-notice {\n    bottom: calc(44px + 12px + env(safe-area-inset-bottom, 0px));\n    width: max-content;\n    max-width: calc(100vw - 32px);\n    text-align: center;\n  }\n\n  /* ---- Tabs (TabBar.tsx): a row a thumb scrolls. ---- */\n\n  :root[data-window-chrome=\"mobile\"] .tab-bar {\n    gap: 4px;\n    padding-left: 8px;\n    padding-right: 4px;\n    overscroll-behavior-x: contain;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .tab-bar::-webkit-scrollbar {\n    display: none;\n  }\n\n  /* Tabs keep their own width and the row scrolls, rather than all of\n     them squeezing down to unreadable stubs. */\n  :root[data-window-chrome=\"mobile\"] .tab-pill {\n    flex-shrink: 0;\n    min-width: 0;\n    max-width: 180px;\n    min-height: 36px;\n    padding: 0 0 0 12px;\n    gap: 0;\n    /* The close button's 44pt reaches past the pill's 36. */\n    overflow: visible;\n    font-size: var(--ios-subhead);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .tab-pill-dirty-dot {\n    margin-right: 6px;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .tab-pill:hover:not(.tab-pill-active) {\n    background: none;\n  }\n\n  /* Always shown, as Safari's tab close is, and a full fingertip wide. */\n  :root[data-window-chrome=\"mobile\"] .tab-pill-close {\n    flex-shrink: 0;\n    justify-content: center;\n    width: 44px;\n    height: 44px;\n    margin: -4px 0;\n    padding: 0;\n    opacity: 0.7;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .tab-pill-close:hover {\n    background: none;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .tab-bar-add {\n    min-width: 44px;\n    min-height: 44px;\n    font-size: 20px;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .tab-bar-add:hover {\n    background: none;\n  }\n}\n/* The editor's own controls at iPhone width. The desktop reaches several\n   of them by hover, at sizes made for a pointer; a finger gets their\n   commands on the keyboard toolbar instead (KeyboardToolbar.tsx), and what\n   stays in the page is sized for a touch. */\n@media (max-width: 760px) {\n  /* A table's \"+\" strips (table-hover-view.ts) show on hover, which a\n     touch never gives, and are 16px targets; the toolbar's table buttons\n     add rows and columns where the caret is. */\n  :root[data-window-chrome=\"mobile\"]\n    :is(.table-add-row-btn, .table-add-col-btn) {\n    display: none;\n  }\n\n  /* An image's resize grip is 6px wide - not something a finger can take\n     hold of. The toolbar's width presets size a tapped image. */\n  :root[data-window-chrome=\"mobile\"] .image-resize-handle {\n    display: none;\n  }\n\n  /* A code block's language picker (code-block-language-view.ts), shown\n     while the caret is in the block: a 44pt target in text that reads at\n     arm's length - 16px, below which iOS zooms the page into a focused\n     control. */\n  :root[data-window-chrome=\"mobile\"] .code-block-language-select {\n    min-height: 44px;\n    padding: 0 12px;\n    font-size: 16px;\n  }\n}\n\n/* Completion is accepted with a tap on the suggestion (ghost-text-plugin.ts)\n   rather than Tab, so it has to receive the touch. */\n:root[data-window-chrome=\"mobile\"] .ghost-text {\n  pointer-events: auto;\n}\n\n/* A tap on a list marker, a code block's edge, a formula or a rule makes\n   ProseMirror select the whole block, which its stock stylesheet rings in\n   a light blue (#8cf) whatever the theme - the stray box around a line or\n   several. On a phone the selection is shown as a faint wash in the\n   theme's accent instead; an image keeps its own ring (milkdown-theme.css). */\n:root[data-window-chrome=\"mobile\"]\n  .milkdown\n  .ProseMirror-selectednode:not(.image-view) {\n  outline: none;\n  border-radius: var(--radius-small);\n  background: color-mix(in srgb, var(--editor-accent) 10%, transparent);\n}\n\n:root[data-window-chrome=\"mobile\"]\n  .milkdown\n  li.ProseMirror-selectednode::after {\n  border: none;\n}\n/* Textus AI on a phone: the panel as a bottom sheet with a handle, the\n   Quick Ask dock above the keyboard and the touch-sized composer\n   (quick-ask-dock.css and composer.css, beside this file). */\n\n@media (max-width: 760px) {\n  /* Textus AI is a bottom sheet: about half the screen, so the document\n     stays in view above it - an edit it proposes can be read against the\n     text. The handle on top (AgentPanelSheetGrip) pulls it up to full\n     height or down to close. The width a desktop user dragged it to means\n     nothing here, hence the !important over the inline style. */\n  :root[data-window-chrome=\"mobile\"] .agent-panel {\n    position: fixed;\n    /* The half stop - 55% of the screen, SHEET_HALF in agent-panel.tsx -\n       set by where its top sits, not by a height. Raising the keyboard\n       moved the sheet's bottom up with it a frame or two before the web\n       view had shrunk (KeyboardFit.swift): a height then kept its old\n       value and shot the top ~150pt up the screen and back. A top keeps\n       its place until the new size lands. */\n    top: 45%;\n    right: 0;\n    bottom: 0;\n    left: 0;\n    z-index: 40;\n    width: auto !important;\n    max-width: none;\n    height: auto;\n    padding-top: 0;\n    border-left: none;\n    border-top: 1px solid var(--border-color);\n    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;\n    box-shadow: var(--shadow-sheet);\n    flex-direction: column;\n    /* Whatever the conversation's length, the composer stays on screen:\n       the message list scrolls inside the sheet instead. */\n    overflow: hidden;\n    /* Up from the bottom edge on a spring; closed, back down. */\n    animation: motion-sheet-in var(--dur-sheet) var(--ease-spring);\n  }\n\n  /* Once it has been carried, it has entered: the entrance must not\n     start over when the drag hands it back to its stop (agent-panel.tsx,\n     setSheetDown). Closing, below, still animates. */\n  :root[data-window-chrome=\"mobile\"] .agent-panel[data-settled] {\n    animation: none;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .agent-panel[data-state=\"closing\"] {\n    animation: motion-sheet-out var(--dur-sheet-exit) var(--ease-in) forwards;\n  }\n\n  /* Let go below its lowest stop, it has already gone down off the screen\n     under the finger. */\n  :root[data-window-chrome=\"mobile\"] .agent-panel[data-dismissed] {\n    animation: none;\n  }\n\n  /* Carried - under a finger, or settling where it was let go - the sheet\n     is laid out at full height and moved by its transform alone, never\n     by its height (AgentPanelSheetGrip). The composer and the bars over\n     it are lifted by as much as the sheet is lowered, so they stay on the\n     screen's bottom edge, and are opaque, as the message list now runs on\n     under them. A shadow the sheet's colour fills in below its edge while\n     it is pulled past the top stop. */\n  :root[data-window-chrome=\"mobile\"] .agent-panel[data-carried] {\n    /* Its inline height lays it out from the bottom edge up. */\n    top: auto;\n    animation: none;\n    box-shadow:\n      var(--shadow-sheet),\n      0 200px 0 var(--editor-bg, var(--bg));\n    will-change: transform;\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    .agent-panel[data-carried]\n    .agent-panel-body\n    > :not(.agent-panel-empty, .inline-chat-messages) {\n    transform: translateY(var(--sheet-lift, 0px));\n    background-color: var(--editor-bg, var(--bg));\n  }\n\n  :root[data-window-chrome=\"mobile\"] .agent-panel .inline-chat-messages {\n    overscroll-behavior: contain;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .agent-panel-sheet-full {\n    top: var(--mobile-bar);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .agent-panel-resizer {\n    display: none;\n  }\n\n  /* The sheet's header rides up beside the grip instead of a row of its\n     own - Conversation / Memory on the left, + and x on the right; the\n     rest of that row lets touches through to the grip under it. */\n  :root[data-window-chrome=\"mobile\"] .agent-panel-header {\n    /* The grip's height: the buttons centre on the grip's line. */\n    margin-top: -44px;\n    min-height: 44px;\n    padding-top: 0;\n    padding-bottom: 0;\n    pointer-events: none;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .agent-panel-actions,\n  :root[data-window-chrome=\"mobile\"] .agent-panel-tabs {\n    pointer-events: auto;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .agent-panel-tabs button {\n    padding: 8px 14px;\n    font-size: var(--text-md);\n  }\n\n  /* New conversation and close: finger-sized, like every other button on\n     the phone. */\n  :root[data-window-chrome=\"mobile\"]\n    .agent-panel-actions\n    .inline-chat-header-button {\n    width: 44px;\n    height: 44px;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .agent-panel-placeholder {\n    inset: 44px 0 0;\n  }\n}\n\n/* Wider than a phone (iPad) the panel is a column, not a sheet. */\n@media (min-width: 761px) {\n  :root[data-window-chrome=\"mobile\"] .agent-panel-grip {\n    display: none;\n  }\n\n  /* The docked column clears the taller title row. */\n  :root[data-window-chrome=\"mobile\"] .agent-panel {\n    padding-top: var(--mobile-bar);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .agent-panel-placeholder {\n    inset: var(--mobile-bar) 0 0;\n  }\n}\n\n/* The sheet's handle: a short bar across the top, the whole strip\n   draggable. */\n:root[data-window-chrome=\"mobile\"] .agent-panel-grip {\n  display: flex;\n  flex: 0 0 44px;\n  align-items: center;\n  justify-content: center;\n  touch-action: none;\n  cursor: grab;\n}\n\n:root[data-window-chrome=\"mobile\"] .agent-panel-grip span {\n  width: 36px;\n  height: 5px;\n  border-radius: var(--radius-pill);\n  background: color-mix(in srgb, var(--editor-text) 25%, transparent);\n}\n/* Quick Ask on an iPhone (InlineChat's `docked`): a composer docked to the\n   bottom of the screen, like Messages' input bar, instead of a block in the\n   document. In the document it opened under the passage - which on a phone\n   is under the keyboard, in a page whose own scrolling is off\n   (KeyboardFit.swift). The web view ends at the top of the keyboard, so\n   bottom: 0 is right above it; with the keyboard down it is the screen's\n   bottom edge, above the home indicator.\n\n   Top to bottom: what it is about (the quoted selection, or \"at the\n   cursor\") with the panel's buttons, then the reply and the review bar in\n   a short area that scrolls, then the input. Proposed edits still preview\n   in the document itself, which scrolls clear of the panel\n   (quick-ask-dock.ts). Only rendered on a phone, so nothing here needs the\n   phone media query. */\n\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock {\n  position: fixed;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  /* Over the AI sheet (40) - opened from the document, it is the newer of\n     the two - and under the title row (45) and the sidebar drawer (44). */\n  z-index: 41;\n  max-width: none;\n  margin: 0;\n  font-family: var(--font-sans);\n  color: var(--editor-text);\n}\n\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock .inline-chat-shell {\n  /* Never taller than the page below the title row; the reply area gives\n     way first (below). */\n  max-height: calc(100dvh - var(--mobile-bar, 44px) - 8px);\n  padding-bottom: env(safe-area-inset-bottom, 0px);\n  border-width: 1px 0 0;\n  border-color: var(--editor-border);\n  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;\n  background: var(--page-bg, var(--editor-bg));\n  box-shadow: var(--shadow-sheet);\n  /* It rises with the keyboard, from the bottom edge. */\n  animation: motion-sheet-in var(--dur-slow) var(--ease-spring);\n}\n\n/* The context row is the composer's (ChatComposer renders it), but it\n   reads first: above the reply, as the header of the whole panel. */\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock-head {\n  order: -1;\n  display: flex;\n  align-items: center;\n  gap: 2px;\n  min-height: 44px;\n  padding: 0 4px 0 12px;\n}\n\n/* Every section under it is ruled off - including the input when there is\n   no reply yet. */\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock .inline-chat-shell > * {\n  border-top: 1px solid var(--editor-border);\n}\n\n:root[data-window-chrome=\"mobile\"]\n  .quick-ask-dock\n  .inline-chat-shell\n  > .quick-ask-dock-head {\n  border-top: none;\n}\n\n/* The passage on one line, marked like a quotation. Line breaks in it\n   collapse to spaces. */\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock-quote {\n  flex: 1;\n  min-width: 0;\n  padding-left: 8px;\n  border-left: 2px solid var(--editor-accent);\n  overflow: hidden;\n  white-space: nowrap;\n  text-overflow: ellipsis;\n  font-size: var(--text-sm);\n  color: var(--editor-muted);\n}\n\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock-actions {\n  display: flex;\n  flex-shrink: 0;\n}\n\n/* New, continue in the panel, close, and dropping the selection: full\n   44pt targets, not the desktop's 24px corner icons. */\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock .inline-chat-header-button,\n:root[data-window-chrome=\"mobile\"]\n  .quick-ask-dock-head\n  .inline-chat-chip-remove {\n  width: 44px;\n  height: 44px;\n  justify-content: center;\n}\n\n:root[data-window-chrome=\"mobile\"]\n  .quick-ask-dock\n  .inline-chat-header-button\n  svg {\n  width: 18px;\n  height: 18px;\n}\n\n/* The reply: the one part that scrolls, held to about 40% of the page so\n   the input and the passage above the panel stay in view. */\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock .quick-ask-status {\n  flex: 0 1 auto;\n  min-height: 0;\n  max-height: 40vh;\n  max-height: 40dvh;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n}\n\n/* Opened out in full, the transcript scrolls inside that area rather than\n   adding a second limit of its own. */\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock .quick-ask-transcript {\n  max-height: calc(40dvh - 64px);\n}\n\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock .quick-ask-more {\n  min-height: 44px;\n}\n\n/* Review: accept, reject, previous, next - finger-sized. */\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock .quick-ask-pending-bar {\n  flex-shrink: 0;\n  flex-wrap: wrap;\n  padding: 4px 8px;\n}\n\n:root[data-window-chrome=\"mobile\"]\n  .quick-ask-dock\n  :is(.inline-chat-action, .quick-ask-split-menu-item) {\n  min-height: 44px;\n}\n\n:root[data-window-chrome=\"mobile\"]\n  .quick-ask-dock\n  .quick-ask-pending-nav-button {\n  width: 44px;\n  height: 44px;\n  font-size: 22px;\n}\n\n/* \"Accept all\" opens upward: below the bar is the input. */\n:root[data-window-chrome=\"mobile\"] .quick-ask-dock .quick-ask-split-menu {\n  top: auto;\n  bottom: calc(100% + 4px);\n}\n\n/* The panel takes the keyboard toolbar's place (it is the bar above the\n   keyboard now), and the document scrolls clear of it, its end included. */\n:root[data-window-chrome=\"mobile\"].has-quick-ask-dock .keyboard-toolbar {\n  display: none;\n}\n\n:root[data-window-chrome=\"mobile\"].has-quick-ask-dock .editor-scroll {\n  padding-bottom: var(--quick-ask-dock-height, 0px);\n}\n/* The AI composer on an iPhone (ChatComposer.tsx), in the docked Quick Ask\n   and the Textus AI sheet alike: every control a 44pt target - Apple's\n   minimum - and no :hover left stuck on whatever was tapped last. Phone\n   width only, like the rest of the phone layout (mobile/styles): an iPad\n   keeps the desktop's compact composer. */\n\n/* Ask / Edit / Plan as a segmented control: a tinted track with the\n   chosen segment raised out of it. Rendered only on a phone. */\n:root[data-window-chrome=\"mobile\"] .chat-mode-segments {\n  display: inline-flex;\n  flex-shrink: 0;\n  padding: 2px;\n  border-radius: var(--radius-surface);\n  background: color-mix(in srgb, var(--editor-text) 8%, transparent);\n}\n\n:root[data-window-chrome=\"mobile\"] .chat-mode-segment {\n  min-width: 56px;\n  min-height: 40px;\n  padding: 0 12px;\n  border: none;\n  /* Concentric with the track: its radius less its padding. */\n  border-radius: calc(var(--radius-surface) - 2px);\n  background: none;\n  color: var(--editor-text);\n  font: inherit;\n  font-size: var(--text-sm);\n  font-weight: 500;\n}\n\n:root[data-window-chrome=\"mobile\"] .chat-mode-segment[aria-checked=\"true\"] {\n  background: var(--editor-bg, var(--bg));\n  box-shadow: var(--shadow-raised);\n  font-weight: 600;\n}\n\n@media (max-width: 760px) {\n  :root[data-window-chrome=\"mobile\"]\n    :is(.inline-chat-attach, .inline-chat-web-search) {\n    width: 44px;\n    height: 44px;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .inline-chat-send {\n    min-height: 44px;\n    padding: 0 18px;\n    font-size: var(--text-md);\n  }\n\n  /* The chips stay small to look at; their x reaches past their edges. */\n  :root[data-window-chrome=\"mobile\"] .inline-chat-selection-chip {\n    overflow: visible;\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    .inline-chat-toolbar\n    .inline-chat-chip-remove,\n  :root[data-window-chrome=\"mobile\"] .inline-chat-attachment-remove {\n    justify-content: center;\n    width: 44px;\n    height: 44px;\n    margin: -14px -12px -14px -8px;\n  }\n\n  /* The / skill and @ file suggestions: rows a finger can pick. */\n  :root[data-window-chrome=\"mobile\"] .inline-chat-skill-item {\n    align-items: center;\n    min-height: 44px;\n    font-size: var(--text-md);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .inline-chat-skill-menu {\n    max-height: 220px;\n    overscroll-behavior: contain;\n  }\n\n  /* A skill's two lines stay left-aligned, centred in the row's height. */\n  :root[data-window-chrome=\"mobile\"] .composer-picker-item {\n    align-items: stretch;\n    justify-content: center;\n  }\n\n  /* A tap leaves :hover on what it touched until something else is; the\n     pressed state (:active) is the feedback instead. */\n  :root[data-window-chrome=\"mobile\"]\n    .inline-chat-skill-item:hover:not(.inline-chat-skill-item-active, :active) {\n    background: transparent;\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    :is(\n      .inline-chat-attach,\n      .inline-chat-web-search:not(.is-active),\n      .inline-chat-header-button,\n      .quick-ask-pending-nav-button\n    ):not(:disabled, :active):hover {\n    background: transparent;\n    color: var(--editor-muted);\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    .inline-chat-action:not(.inline-chat-action-primary):not(\n      :disabled,\n      :active\n    ):hover {\n    background: transparent;\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    :is(.inline-chat-send, .inline-chat-action-primary):not(:disabled):hover {\n    border-color: var(--ui-primary);\n    background: var(--ui-primary);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .inline-chat-chip-remove:hover {\n    opacity: 0.6;\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    :is(\n      .inline-chat-attach,\n      .inline-chat-web-search,\n      .inline-chat-header-button,\n      .quick-ask-pending-nav-button,\n      .inline-chat-action:not(.inline-chat-action-primary),\n      .inline-chat-skill-item\n    ):active {\n    background: color-mix(in srgb, var(--editor-text) 12%, transparent);\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    :is(.inline-chat-send, .inline-chat-action-primary):not(:disabled):active {\n    background: color-mix(in srgb, var(--ui-primary) 86%, var(--ui-on-primary));\n  }\n}\n\n/* Attach and web search: symbols at the size of the buttons around them. */\n:root[data-window-chrome=\"mobile\"] .inline-chat-bar button svg {\n  width: 18px;\n  height: 18px;\n}\n/* Settings on a phone: the same panel as the desktop's (SettingsPanel),\n   filling the screen. Only its frame and sizes change here - the rows,\n   the categories and their order are the desktop's own, so there is no\n   second settings page to keep in step. The categories become a row of\n   tabs along the top (SettingsPanel.css's narrow layout). */\n\n/* Done, as iOS writes it: a word in the accent colour, on the iPad's\n   dialog too. It is also a .text-button, whose sidebar rule (app/sidebar-frame.css)\n   stretches it across the whole header with a border and a bottom margin. */\n:root[data-window-chrome=\"mobile\"] .settings-done-button {\n  width: auto;\n  margin: 0;\n  padding: 0 12px;\n  border: none;\n  background: none;\n  color: var(--editor-accent);\n  font-size: var(--ios-body);\n}\n\n@media (max-width: 760px) {\n  /* The whole screen, title row included. It comes up from the bottom\n     edge as an iOS modal sheet does, over a page that dims behind it, and\n     goes back down when it closes. */\n  :root[data-window-chrome=\"mobile\"] .settings-backdrop {\n    top: 0;\n    z-index: var(--z-phone-page);\n    /* The dimming is a layer of its own (below), so it fades while the\n       sheet in front of it stays opaque - faded together, the page showed\n       through the rising sheet. */\n    background: none;\n    animation: none;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .settings-backdrop::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: var(--overlay-bg);\n    animation: motion-fade-in var(--dur-sheet) var(--ease-standard);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .settings-panel {\n    position: relative;\n    animation: motion-sheet-in var(--dur-sheet) var(--ease-spring);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .settings-backdrop[data-state=\"closing\"] {\n    animation: none;\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    .settings-backdrop[data-state=\"closing\"]::before {\n    animation: motion-fade-out var(--dur-sheet-exit) var(--ease-in) forwards;\n  }\n\n  :root[data-window-chrome=\"mobile\"]\n    .settings-backdrop[data-state=\"closing\"]\n    > .settings-panel {\n    animation: motion-sheet-out var(--dur-sheet-exit) var(--ease-in) forwards;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .settings-panel {\n    width: 100%;\n    max-width: none;\n    height: 100%;\n    max-height: none;\n    border: none;\n    border-radius: 0;\n    /* The spring overshoots a few points past the top: the page's colour\n       fills in below its edge, where the document showed. */\n    box-shadow: 0 48px 0 var(--grouped-page);\n  }\n\n  /* A navigation bar: the title centred, Done at the right. */\n  :root[data-window-chrome=\"mobile\"] .settings-header {\n    position: relative;\n    justify-content: center;\n    min-height: 44px;\n    padding: 0 16px;\n    font-size: var(--ios-body);\n    font-weight: 600;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .settings-done-button {\n    position: absolute;\n    top: 0;\n    right: 4px;\n    min-height: 44px;\n  }\n\n  /* Four tabs across one screen, English's \"Editor & Appearance\" and\n     \"Textus AI\" included: the tightest spacing that still fits them on a\n     375pt iPhone. */\n  :root[data-window-chrome=\"mobile\"] .settings-nav {\n    padding: 8px 8px;\n    gap: 2px;\n    border-bottom: 1px solid var(--border-color);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .settings-nav-item {\n    min-height: 36px;\n    padding: 0 8px;\n    border-radius: var(--radius-pill);\n    font-size: 14px;\n  }\n\n  /* The tab says which category this is; no second title under it. */\n  :root[data-window-chrome=\"mobile\"] .settings-category-title {\n    display: none;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .settings-content {\n    padding: 16px 16px 32px;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .settings-group + .settings-group,\n  :root[data-window-chrome=\"mobile\"] .settings-advanced {\n    margin-top: 28px;\n  }\n\n  :root[data-window-chrome=\"mobile\"] .settings-group-title {\n    font-size: var(--ios-footnote);\n  }\n\n  :root[data-window-chrome=\"mobile\"] .settings-row {\n    min-height: 52px;\n    gap: 12px;\n  }\n\n  /* A short name gives its room to the control