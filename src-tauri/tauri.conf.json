{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Textus",
  "version": "1.0.3",
  "identifier": "com.catvinci.textus",
  "build": {
    "beforeDevCommand": "node scripts/prepare-harness.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-harness.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Textus",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 320,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "\u00a9 2026 CatVinci Studio",
    "homepage": "https://github.com/CatVinci-Studio/Textus",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGQjI1MzU1RkRGODBDNkIKUldSckRQajlWVk95Yjc1VDNTZktOOUlSYy85aDlLLzZnNUJQdG1VamwzTDRvby81eWZKOG1GTmsK",
      "endpoints": [
        "https://github.com/CatVinci-Studio/Textus/releases/latest/download/textus-latest.json"
      ]
    }
  }
}
