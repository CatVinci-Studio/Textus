{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Textus",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "Spanish",
          "French",
          "German",
          "Russian",
          "PortugueseBR"
        ],
        "compression": "lzma"
      }
    },
    "resources": {
      "resources/harness/": "harness/"
    }
  }
}
