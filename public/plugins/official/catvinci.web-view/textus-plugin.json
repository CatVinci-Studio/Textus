{
  "id": "catvinci.web-view",
  "name": "%name%",
  "version": "1.0.0",
  "publisher": "catvinci",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/Textus",
  "engines": { "textus": "^1.3.0" },
  "main": "host.js",
  "permissions": ["network:*", "document.read"],
  "contributes": {
    "commands": [
      { "command": "catvinci.web-view.open", "title": "%open%" },
      { "command": "catvinci.web-view.openSelection", "title": "%openSelection%" },
      { "command": "catvinci.web-view.home", "title": "%home%" }
    ],
    "menus": {
      "app/plugins": [
        { "command": "catvinci.web-view.open" },
        { "command": "catvinci.web-view.home" }
      ],
      "editor/context": [
        { "command": "catvinci.web-view.openSelection", "when": "editorHasSelection" }
      ]
    },
    "settings": [
      {
        "key": "home",
        "type": "string",
        "default": "https://en.wikipedia.org",
        "title": "%homeSetting%"
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "Web View",
      "description": "Open web pages in a tab beside your notes.",
      "open": "Open a Web Page…",
      "openSelection": "Open the Selected Link in a Tab",
      "home": "Open the Home Page",
      "homeSetting": "Home page",
      "prompt": "Web address"
    },
    "zh": {
      "name": "网页视图",
      "description": "在笔记旁边的标签页里打开网页。",
      "open": "打开网页…",
      "openSelection": "在标签页中打开选中的链接",
      "home": "打开主页",
      "homeSetting": "主页",
      "prompt": "网址"
    }
  }
}
