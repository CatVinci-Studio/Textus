{
  "id": "catvinci.zotero",
  "name": "Zotero",
  "version": "1.0.0",
  "publisher": "catvinci",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/Textus",
  "engines": { "textus": "^1.3.0" },
  "main": "host.js",
  "permissions": ["network:localhost:23119", "document.propose"],
  "contributes": {
    "commands": [{ "command": "catvinci.zotero.cite", "title": "%cite%" }],
    "keybindings": [{ "command": "catvinci.zotero.cite", "key": "mod+alt+c" }],
    "menus": {
      "app/plugins": [{ "command": "catvinci.zotero.cite" }],
      "editor/context": [{ "command": "catvinci.zotero.cite" }]
    },
    "settings": [
      {
        "key": "style",
        "type": "enum",
        "default": "pandoc",
        "title": "%style%",
        "description": "%styleHelp%",
        "options": [
          { "value": "pandoc", "label": "%pandoc%" },
          { "value": "text", "label": "%text%" },
          { "value": "link", "label": "%link%" }
        ]
      }
    ]
  },
  "l10n": {
    "en": {
      "description": "Cite from your Zotero library while you write. Needs Zotero 7 running, with Settings › Advanced › Allow other applications on this computer to communicate with Zotero on.",
      "cite": "Insert a Citation from Zotero…",
      "style": "A citation is written as",
      "styleHelp": "Pandoc keys turn into references when the document is exported with Pandoc.",
      "pandoc": "A Pandoc key: [@key]",
      "text": "Author and year: (Author, 2024)",
      "link": "A link that opens Zotero"
    },
    "zh": {
      "description": "写作时直接从 Zotero 文献库插入引用。需要 Zotero 7 正在运行，并在设置 › 高级 中打开“允许此计算机上的其他应用程序与 Zotero 通信”。",
      "cite": "从 Zotero 插入引用…",
      "style": "引用的写法",
      "styleHelp": "用 Pandoc 导出文档时，Pandoc 键会变成参考文献。",
      "pandoc": "Pandoc 键：[@key]",
      "text": "作者和年份：(Author, 2024)",
      "link": "能打开 Zotero 的链接"
    }
  }
}
