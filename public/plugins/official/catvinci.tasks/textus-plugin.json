{
  "id": "catvinci.tasks",
  "name": "%name%",
  "version": "1.0.0",
  "publisher": "catvinci",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/Textus",
  "engines": { "textus": "^1.3.0" },
  "main": "host.js",
  "permissions": ["workspace.read", "workspace.write"],
  "contributes": {
    "sidebarTabs": [
      { "id": "catvinci.tasks.panel", "title": "%name%", "icon": "tab.svg" }
    ],
    "settings": [
      {
        "key": "showDone",
        "type": "boolean",
        "default": false,
        "title": "%showDone%"
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "Tasks",
      "description": "Every task (- [ ]) in the open folder's documents, in one list: tick one off there, or go to it.",
      "showDone": "Show finished tasks"
    },
    "zh": {
      "name": "任务",
      "description": "把打开的文件夹里所有文档中的任务（- [ ]）汇总成一个列表：可以直接勾掉，也可以跳到它所在的地方。",
      "showDone": "显示已完成的任务"
    }
  }
}
