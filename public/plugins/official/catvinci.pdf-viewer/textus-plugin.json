{
  "id": "catvinci.pdf-viewer",
  "name": "%name%",
  "version": "1.0.0",
  "publisher": "catvinci",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/Textus",
  "engines": { "textus": "^1.3.0" },
  "main": "host.js",
  "permissions": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "catvinci.pdf-viewer.pdf",
        "displayName": "%name%",
        "filenamePatterns": ["*.pdf"]
      }
    ],
    "settings": [
      {
        "key": "zoom",
        "type": "enum",
        "default": "fit",
        "title": "%zoom%",
        "options": [
          { "value": "fit", "label": "%zoomFit%" },
          { "value": "100", "label": "100%" }
        ]
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "PDF Viewer",
      "description": "Open PDFs in a tab beside your notes: pages, zoom, and text to select and copy.",
      "zoom": "A PDF opens at",
      "zoomFit": "The window's width"
    },
    "zh": {
      "name": "PDF 阅读器",
      "description": "在笔记旁边的标签页里打开 PDF：翻页、缩放，文字可以选中和复制。",
      "zoom": "PDF 打开时的大小",
      "zoomFit": "适应窗口宽度"
    }
  }
}
