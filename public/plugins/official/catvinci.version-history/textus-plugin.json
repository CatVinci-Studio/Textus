{
  "id": "catvinci.version-history",
  "name": "%name%",
  "version": "1.0.0",
  "publisher": "catvinci",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/Textus",
  "engines": { "textus": "^1.3.0" },
  "main": "host.js",
  "activationEvents": ["onStartupFinished"],
  "permissions": ["workspace.read", "document.read", "document.propose"],
  "contributes": {
    "sidebarTabs": [
      { "id": "catvinci.version-history.panel", "title": "%history%", "icon": "tab.svg" }
    ],
    "settings": [
      {
        "key": "keep",
        "type": "number",
        "default": 50,
        "title": "%keep%"
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "Version History",
      "description": "Each save of a document kept as a version: see what changed since, and bring an old one back.",
      "history": "History",
      "keep": "Versions kept per document"
    },
    "zh": {
      "name": "版本历史",
      "description": "文档每次保存都会留一个版本：可以看出之后改了什么，也能把旧版本找回来。",
      "history": "历史",
      "keep": "每篇文档保留的版本数"
    }
  }
}
