{
  "id": "catvinci.graph",
  "name": "%name%",
  "version": "1.0.0",
  "publisher": "catvinci",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/Textus",
  "engines": { "textus": "^1.3.0" },
  "main": ["links.js", "host.js"],
  "permissions": ["workspace.read", "document.read"],
  "contributes": {
    "commands": [{ "command": "catvinci.graph.open", "title": "%open%" }],
    "keybindings": [{ "command": "catvinci.graph.open", "key": "mod+alt+g" }],
    "menus": { "app/plugins": [{ "command": "catvinci.graph.open" }] },
    "views": [{ "id": "catvinci.graph.global", "title": "%name%" }],
    "sidebarTabs": [
      { "id": "catvinci.graph.local", "title": "%local%", "icon": "tab.svg" }
    ],
    "settings": [
      {
        "key": "depth",
        "type": "enum",
        "default": "1",
        "title": "%depth%",
        "options": [
          { "value": "1", "label": "%depth1%" },
          { "value": "2", "label": "%depth2%" }
        ]
      },
      {
        "key": "orphans",
        "type": "boolean",
        "default": true,
        "title": "%orphans%"
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "Graph View",
      "description": "Your notes and the links between them as a graph - [[wiki links]] and links to other documents - for the whole folder, or around the document in front.",
      "open": "Open the Graph View",
      "local": "Graph",
      "depth": "The sidebar's graph shows",
      "depth1": "Documents linked to this one",
      "depth2": "Those, and the ones linked to them",
      "orphans": "Show documents with no links in the full graph"
    },
    "zh": {
      "name": "知识图谱",
      "description": "把笔记和它们之间的链接画成图谱——[[双链]] 和指向其他文档的链接——可以看整个文件夹，也可以只看当前文档周围。",
      "open": "打开知识图谱",
      "local": "图谱",
      "depth": "侧边栏图谱显示",
      "depth1": "和这篇文档直接相连的文档",
      "depth2": "再往外一层",
      "orphans": "在完整图谱中显示没有链接的文档"
    }
  }
}
