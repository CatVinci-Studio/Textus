{
  "id": "catvinci.kanban",
  "name": "%name%",
  "version": "1.0.0",
  "publisher": "catvinci",
  "description": "%description%",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": "https://github.com/CatVinci-Studio/Textus",
  "engines": { "textus": "^1.3.0" },
  "main": "host.js",
  "permissions": ["workspace.read", "workspace.write"],
  "contributes": {
    "commands": [{ "command": "catvinci.kanban.new", "title": "%new%" }],
    "menus": { "app/plugins": [{ "command": "catvinci.kanban.new" }] },
    "customEditors": [
      {
        "viewType": "catvinci.kanban.board",
        "displayName": "%name%",
        "filenamePatterns": ["*.kanban.md"]
      }
    ]
  },
  "l10n": {
    "en": {
      "name": "Kanban",
      "description": "Boards of cards in lists, kept as a Markdown file (name.kanban.md) - a list per heading, a card per task.",
      "new": "New Kanban Board…"
    },
    "zh": {
      "name": "看板",
      "description": "把卡片按列表排成看板，保存为一个 Markdown 文件（名称.kanban.md）：每个标题是一列，每个任务是一张卡片。",
      "new": "新建看板…"
    }
  }
}
