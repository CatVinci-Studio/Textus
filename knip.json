{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/playground/main.tsx",
    "src/plugin-api.ts",
    "src/**/*.test.{ts,tsx}",
    "scripts/**/*.mjs",
    "*.config.ts",
    "e2e/**/*.{spec,perf,bench}.ts",
    "e2e/shots/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.mjs"],
  "ignore": ["src/platform/bindings/**"],
  "ignoreExportsUsedInFile": false,
  "rules": {
    "duplicates": "off"
  },
  "ignoreDependencies": ["jscpd"]
}
