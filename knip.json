{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/playground/main.tsx",
    "src/plugin-api.ts",
    "src/**/*.test.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/**/*.mjs",
    "*.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.mjs"],
  "ignore": ["src/platform/bindings/**"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  }
}
